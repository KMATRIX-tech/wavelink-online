{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information with account status, username, bio, avatar, and saved items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string", "maxLength": 40 },
        "displayName": { "type": "string", "maxLength": 80 },
        "photoURL": { "type": "string" },
        "bio": { "type": "string", "maxLength": 280 },
        "status": { "type": "string", "enum": ["active", "warned", "banned"] },
        "warningMessage": { "type": "string", "maxLength": 500 },
        "isBanned": { "type": "boolean" },
        "savedPostIds": { "type": "array" },
        "chatThemes": { "type": "object" },
        "isSubAdmin": { "type": "boolean" },
        "role": { "type": "string", "enum": ["super_admin", "sub_admin", "user"] },
        "hasBlueStar": { "type": "boolean" },
        "isPro": { "type": "boolean" },
        "proPlan": { "type": "string", "enum": ["weekly", "monthly", "annual"] },
        "proExpiresAt": { "type": "string" },
        "proBadge": { "type": "string", "enum": ["verified", "vip", "creator", "founder"] },
        "proBorderEffect": { "type": "string", "enum": ["aura-gold", "neon-pulse", "cosmic-glow", "emerald-ring", "none"] },
        "proAccentColor": { "type": "string", "enum": ["purple", "gold", "emerald", "neon", "crimson"] },
        "points": { "type": "number" },
        "wavePoints": { "type": "number" },
        "loginStreak": { "type": "number" },
        "lastDailyRewardDate": { "type": "string" },
        "lastDailyRewardAmount": { "type": "number" },
        "totalLoginDays": { "type": "number" },
        "pointTransactions": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "status", "isBanned"]
    },
    "Post": {
      "title": "Post",
      "description": "User shared posts and videos in the community feed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 80 },
        "authorUsername": { "type": "string", "maxLength": 40 },
        "authorPhotoURL": { "type": "string" },
        "content": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "hasVideoChunks": { "type": "boolean" },
        "videoFileName": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video", "none"] },
        "likes": { "type": "array" },
        "likesCount": { "type": "number" },
        "reactions": { "type": "object" },
        "reactionCounts": { "type": "object" },
        "commentsCount": { "type": "number" },
        "savesCount": { "type": "number" },
        "songTitle": { "type": "string" },
        "songArtist": { "type": "string" },
        "songAlbumArt": { "type": "string" },
        "songPreviewUrl": { "type": "string" },
        "songAlbumName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "authorId", "authorEmail", "authorName", "content", "likesCount"]
    },
    "Spark": {
      "title": "Spark",
      "description": "24-hour ephemeral legendary moments with photo or video uploaded directly to Firebase Storage, storing only URL and metadata in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 80 },
        "authorUsername": { "type": "string", "maxLength": 40 },
        "authorPhotoURL": { "type": "string" },
        "legendaryTag": { "type": "string", "maxLength": 60 },
        "caption": { "type": "string", "maxLength": 500 },
        "mediaUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "hasVideoChunks": { "type": "boolean" },
        "videoFileName": { "type": "string" },
        "videoDurationSeconds": { "type": "number" },
        "videoWidth": { "type": "number" },
        "videoHeight": { "type": "number" },
        "videoFileSize": { "type": "number" },
        "videoMimeType": { "type": "string" },
        "songTitle": { "type": "string" },
        "songArtist": { "type": "string" },
        "songAlbumArt": { "type": "string" },
        "songPreviewUrl": { "type": "string" },
        "likes": { "type": "array" },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "authorId", "authorEmail", "authorName", "mediaType", "createdAt", "expiresAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comments attached to community posts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 80 },
        "authorPhotoURL": { "type": "string" },
        "content": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "authorId", "authorName", "content"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Global community events, church schedules, and official platform notices on the Notice Board",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorName": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorPhotoURL": { "type": "string" },
        "title": { "type": "string", "maxLength": 160 },
        "content": { "type": "string", "maxLength": 3000 },
        "priority": { "type": "string", "enum": ["normal", "urgent"] },
        "type": { "type": "string", "enum": ["announcement", "event", "schedule"] },
        "eventDate": { "type": "string" },
        "eventTime": { "type": "string" },
        "eventLocation": { "type": "string" },
        "imageUrl": { "type": "string" },
        "rsvpUserIds": { "type": "array" },
        "rsvpCount": { "type": "number" },
        "isPinned": { "type": "boolean" },
        "isOfficialPartner": { "type": "boolean" },
        "partnerType": { "type": "string" },
        "partnerBadgeTitle": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorId", "authorEmail", "title", "content", "priority"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Private complaints and tickets submitted by users to admin desk",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "subject": { "type": "string", "maxLength": 140 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved"] },
        "adminReply": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "subject", "message", "status"]
    },
    "ChannelMessage": {
      "title": "ChannelMessage",
      "description": "Real-time chat messages in general and direct channels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderName": { "type": "string", "maxLength": 80 },
        "senderUsername": { "type": "string", "maxLength": 40 },
        "senderPhotoURL": { "type": "string" },
        "text": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video", "none"] },
        "gifUrl": { "type": "string" },
        "replyToId": { "type": "string" },
        "replyToText": { "type": "string", "maxLength": 200 },
        "replyToSenderName": { "type": "string" },
        "isEdited": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "isSystem": { "type": "boolean" },
        "readBy": { "type": "array" },
        "lastSeenAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "channelId", "senderId", "senderEmail", "senderName"]
    },
    "ChatGroup": {
      "title": "ChatGroup",
      "description": "User created community groups with customizable logos, group admins, and members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 280 },
        "logoUrl": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string", "maxLength": 80 },
        "creatorEmail": { "type": "string" },
        "adminIds": { "type": "array" },
        "memberIds": { "type": "array" },
        "lastSeen": { "type": "object" },
        "suggestedTheme": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "creatorId", "adminIds", "memberIds", "createdAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application configuration including call unlocks managed by admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "videoCallsUnlocked": { "type": "boolean" },
        "voiceCallsUnlocked": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "videoCallsUnlocked", "voiceCallsUnlocked"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Mobile money subscription transactions for Airtel Money, M-Pesa, and Tigo Pesa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "planId": { "type": "string", "enum": ["weekly", "monthly", "annual", "boost", "tip"] },
        "provider": { "type": "string", "enum": ["airtel", "mpesa", "tigopesa", "azampay"] },
        "phoneNumber": { "type": "string" },
        "amountTZS": { "type": "number" },
        "amountUSD": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
        "reference": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "planId", "provider", "phoneNumber", "amountTZS", "status", "reference"]
    },
    "PaymentGatewayConfig": {
      "title": "PaymentGatewayConfig",
      "description": "API keys and secrets for Airtel Money, Vodacom M-Pesa, ClickPesa, and AzamPay",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "environment": { "type": "string", "enum": ["sandbox", "live"] },
        "airtelClientId": { "type": "string" },
        "airtelClientSecret": { "type": "string" },
        "mpesaConsumerKey": { "type": "string" },
        "mpesaConsumerSecret": { "type": "string" },
        "mpesaPasskey": { "type": "string" },
        "mpesaShortCode": { "type": "string" },
        "clickpesaApiKey": { "type": "string" },
        "azampayClientId": { "type": "string" },
        "azampaySecret": { "type": "string" },
        "azampayAppName": { "type": "string" },
        "azampayApiKey": { "type": "string" },
        "azampayEnv": { "type": "string", "enum": ["sandbox", "live", "production"] },
        "webhookSecret": { "type": "string" }
      },
      "required": ["id", "environment"]
    },
    "PendingVerification": {
      "title": "PendingVerification",
      "description": "Manual mobile money payment verification requests with SMS transaction IDs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userPhotoURL": { "type": "string" },
        "tierId": { "type": "string", "enum": ["weekly", "monthly", "annual"] },
        "tierName": { "type": "string" },
        "amountTZS": { "type": "number" },
        "carrier": { "type": "string" },
        "transactionId": { "type": "string", "maxLength": 100 },
        "phoneNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string" },
        "approvedAt": { "type": "string" },
        "approvedBy": { "type": "string" }
      },
      "required": ["id", "userId", "transactionId", "amountTZS", "status", "submittedAt"]
    },
    "SystemDomain": {
      "title": "SystemDomain",
      "description": "Registered preview and production domains for OAuth whitelisting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "domain": { "type": "string" },
        "url": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "needs_auth_whitelist"] },
        "lastSeenAt": { "type": "string" },
        "firstSeenAt": { "type": "string" }
      },
      "required": ["id", "domain", "status", "lastSeenAt"]
    },
    "SupportBotConfig": {
      "title": "SupportBotConfig",
      "description": "Admin configuration and daily Gemini cap for the automated WaveLink Support Bot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "enabled": { "type": "boolean" },
        "dailyGeminiCap": { "type": "number" },
        "dailyGeminiUsed": { "type": "number" },
        "usageDate": { "type": "string" },
        "userRateLimitPerMinute": { "type": "number" },
        "maxMessageLength": { "type": "number" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "enabled", "dailyGeminiCap"]
    },
    "SupportBotLog": {
      "title": "SupportBotLog",
      "description": "Audit log of every automated WaveLink Support Bot reply and user report status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string", "maxLength": 80 },
        "channelId": { "type": "string" },
        "userMessage": { "type": "string", "maxLength": 1200 },
        "botReply": { "type": "string", "maxLength": 4000 },
        "language": { "type": "string", "enum": ["en", "sw"] },
        "escalatedToTicketId": { "type": "string" },
        "reportedBadReply": { "type": "boolean" },
        "reportReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "userMessage", "botReply", "createdAt"]
    },
    "ScheduledBotDraft": {
      "title": "ScheduledBotDraft",
      "description": "Scheduled Weekly Community Updates and Spark of the Day drafts approved in the Admin Panel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["weekly_update", "spark_of_the_day"] },
        "title": { "type": "string", "maxLength": 160 },
        "content": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string" },
        "legendaryTag": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["draft", "approved", "posted"] },
        "scheduledFor": { "type": "string" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string" },
        "postedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "title", "content", "status", "scheduledFor", "createdAt"]
    },
    "ContentReport": {
      "title": "ContentReport",
      "description": "User reports against posts, accounts, or bad support bot replies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterEmail": { "type": "string" },
        "reporterName": { "type": "string", "maxLength": 80 },
        "targetType": { "type": "string", "enum": ["user", "post", "bot_reply"] },
        "targetId": { "type": "string" },
        "targetAuthorId": { "type": "string" },
        "targetSummary": { "type": "string", "maxLength": 500 },
        "reason": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["open", "reviewed", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterId", "targetType", "targetId", "reason", "status", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable audit log recording admin bans, role changes, verifications, and deletions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorId": { "type": "string" },
        "actorEmail": { "type": "string" },
        "actorName": { "type": "string", "maxLength": 80 },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "targetLabel": { "type": "string", "maxLength": 160 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "actorId", "actorEmail", "action", "targetId", "details", "createdAt"]
    },
    "SavedPost": {
      "title": "SavedPost",
      "description": "Private bookmark of a post saved by an authenticated user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "contentSnippet": { "type": "string", "maxLength": 500 },
        "savedAt": { "type": "string" }
      },
      "required": ["id", "postId", "userId", "savedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and account standing records"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Public social posts"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments attached to posts"
    },
    "/posts/{postId}/chunks/{chunkId}": {
      "schema": { "type": "object" },
      "description": "Video and media binary chunks for large file uploads"
    },
    "/sparks/{sparkId}": {
      "schema": { "$ref": "#/entities/Spark" },
      "description": "24-hour ephemeral legendary moments"
    },
    "/sparks/{sparkId}/chunks/{chunkId}": {
      "schema": { "type": "object" },
      "description": "Video chunks for spark moments"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Global official platform announcements"
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Complaints and support tickets submitted to admin"
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/ChatGroup" },
      "description": "User created groups"
    },
    "/groups/{groupId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChannelMessage" },
      "description": "Messages in user created groups"
    },
    "/channels/{channelId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChannelMessage" },
      "description": "Real-time communication messages"
    },
    "/appSettings/{settingsId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global platform configurations and feature unlocks"
    },
    "/subscriptions/{subId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Mobile money payment subscriptions"
    },
    "/paymentConfig/{configId}": {
      "schema": { "$ref": "#/entities/PaymentGatewayConfig" },
      "description": "Admin-only payment gateway credentials"
    },
    "/pending_verifications/{verificationId}": {
      "schema": { "$ref": "#/entities/PendingVerification" },
      "description": "Manual mobile money subscription verifications pending admin approval"
    },
    "/system_domains/{domainId}": {
      "schema": { "$ref": "#/entities/SystemDomain" },
      "description": "Registered preview and production domains for OAuth authorized domains configuration"
    },
    "/supportBotConfig/{configId}": {
      "schema": { "$ref": "#/entities/SupportBotConfig" },
      "description": "Admin configuration and daily Gemini cap for the WaveLink Support Bot"
    },
    "/supportBotLogs/{logId}": {
      "schema": { "$ref": "#/entities/SupportBotLog" },
      "description": "Logs of WaveLink Support Bot conversations and reported replies"
    },
    "/scheduledBotDrafts/{draftId}": {
      "schema": { "$ref": "#/entities/ScheduledBotDraft" },
      "description": "Scheduled Weekly Updates and Spark of the Day drafts approved by Admin"
    },
    "/contentReports/{reportId}": {
      "schema": { "$ref": "#/entities/ContentReport" },
      "description": "User-submitted reports for posts, accounts, and bot replies"
    },
    "/adminAuditLogs/{auditId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Admin audit trail for bans, role changes, verifications, and deletions"
    },
    "/users/{userId}/savedPosts/{savedPostId}": {
      "schema": { "$ref": "#/entities/SavedPost" },
      "description": "Private bookmark of a post saved under the user account"
    },
    "/savedPosts/{savedPostId}": {
      "schema": { "$ref": "#/entities/SavedPost" },
      "description": "Private collection of saved posts accessible only by the owner or admin"
    }
  }
}

