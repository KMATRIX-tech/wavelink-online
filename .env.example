# GEMINI_API_KEY: Server-side Gemini API key (never exposed to browser)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OWNER_PHONE: Server-only receiving mobile money phone number (never exposed to browser or logs)
OWNER_PHONE="YOUR_OWNER_RECEIVING_PHONE"

# OWNER_EMAIL & OWNER_ACCESS_CODE: Server-only credentials for hidden Owner sign-in (never exposed to browser, GitHub, or logs)
OWNER_EMAIL="YOUR_OWNER_GOOGLE_EMAIL"
OWNER_ACCESS_CODE="YOUR_OWNER_ACCESS_CODE"

# BREVO_API_KEY & MAIL_SENDER: Server-only credentials for Brevo transactional email & SMS verification (never exposed to browser or GitHub)
BREVO_API_KEY="YOUR_BREVO_API_KEY"
MAIL_SENDER="WaveLink <noreply@yourdomain.com>"

# AzamPay Mobile Money Gateway Configuration (Server-only)
AZAMPAY_APP_NAME="WaveLink"
AZAMPAY_CLIENT_ID="YOUR_AZAMPAY_CLIENT_ID"
AZAMPAY_CLIENT_SECRET="YOUR_AZAMPAY_CLIENT_SECRET"
AZAMPAY_API_KEY="YOUR_AZAMPAY_API_KEY"
AZAMPAY_ENV="sandbox"

# PORT: Automatically injected by Render in production
PORT="3000"

# Metered TURN Server Configuration for Video & Voice Calls (Server-side only — never expose to browser)
METERED_DOMAIN="YOUR_APP.metered.live"
METERED_API_KEY="YOUR_METERED_API_KEY"

# Firebase Realtime Database URL (required only if created outside us-central1 / default RTDB URL)
# Example: https://formal-photon-n48x0-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=""

# Firebase Storage Bucket override (defaults to firebase-applet-config.json storageBucket)
VITE_FIREBASE_STORAGE_BUCKET="formal-photon-n48x0.firebasestorage.app"

# Firebase Cloud Messaging Web Push VAPID Public Key (required for real background push notifications)
# Generate in Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=""
