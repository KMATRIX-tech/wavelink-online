# GEMINI_API_KEY: Server-side Gemini API key (never exposed to browser)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OWNER_PHONE: Server-only receiving mobile money phone number (never exposed to browser or logs)
OWNER_PHONE="YOUR_OWNER_RECEIVING_PHONE"

# AzamPay Mobile Money Gateway Configuration (Server-only)
AZAMPAY_APP_NAME="WaveLink"
AZAMPAY_CLIENT_ID="YOUR_AZAMPAY_CLIENT_ID"
AZAMPAY_CLIENT_SECRET="YOUR_AZAMPAY_CLIENT_SECRET"
AZAMPAY_API_KEY="YOUR_AZAMPAY_API_KEY"
AZAMPAY_ENV="sandbox"

# PORT: Automatically injected by Render in production
PORT="3000"

# WebRTC TURN Server Credentials (for mobile data & cross-network video/voice calls)
# Client-side Vite env vars (and optional server-side TURN_URLS / TURN_USERNAME / TURN_CREDENTIAL)
VITE_TURN_URLS="turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp,turns:openrelay.metered.ca:443?transport=tcp"
VITE_TURN_USERNAME="openrelayproject"
VITE_TURN_CREDENTIAL="openrelayproject"
TURN_URLS="turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp,turns:openrelay.metered.ca:443?transport=tcp"
TURN_USERNAME="openrelayproject"
TURN_CREDENTIAL="openrelayproject"
