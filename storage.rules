rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVideoFile() {
      return request.resource.contentType.matches('video/.*');
    }

    function isUnder100MB() {
      return request.resource.size > 0 &&
             request.resource.size <= 100 * 1024 * 1024;
    }

    function isSafeSparkVideoType() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime|ogg|x-m4v|3gpp)');
    }

    function isSafeSparkImageType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    function isValidSparkDuration() {
      return isSafeSparkImageType() || (
        isSafeSparkVideoType() &&
        (!('durationSeconds' in request.resource.metadata) ||
          (int(request.resource.metadata.durationSeconds) >= 1 &&
           int(request.resource.metadata.durationSeconds) <= 90))
      );
    }

    function isValidSparkUpload() {
      return (isSafeSparkVideoType() || isSafeSparkImageType()) &&
             request.resource.size > 0 &&
             request.resource.size <= 100 * 1024 * 1024 &&
             isValidSparkDuration();
    }

    function isValidGeneralMediaType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)') ||
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*');
    }

    function isAdminUser() {
      return isSignedIn() && (
        request.auth.token.email == 'keylanmbilinyi5@gmail.com' ||
        request.auth.token.email == 'keylanmbilinyi5@gnail.com'
      );
    }

    function isProUpload() {
      return isAdminUser() || (
        request.resource.metadata != null &&
        'isPro' in request.resource.metadata &&
        request.resource.metadata.isPro == 'true'
      );
    }

    // Enforce <= 60s for free users and <= 90s for Pro users via customMetadata.durationSeconds
    function isValidVideoDuration() {
      return request.resource.metadata == null ||
        !('durationSeconds' in request.resource.metadata) || (
          float(request.resource.metadata.durationSeconds) > 0 &&
          (isProUpload()
            ? float(request.resource.metadata.durationSeconds) <= 90.5
            : float(request.resource.metadata.durationSeconds) <= 60.5)
        );
    }

    // Dedicated user video uploads folder: only logged-in users can upload to their own folder, video files only, up to 100 MB, 60s free / 90s Pro
    match /users/{userId}/videos/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isVideoFile() && isUnder100MB() && isValidVideoDuration();
      allow delete: if isOwner(userId);
    }

    match /videos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isVideoFile() && isUnder100MB() && isValidVideoDuration();
      allow delete: if isOwner(userId);
    }

    // Video thumbnail uploads alongside videos
    match /users/{userId}/thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isSafeSparkImageType() && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isOwner(userId);
    }

    // 24-hour Spark uploads scoped to userId
    match /sparks/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidSparkUpload();
      allow delete: if isOwner(userId) || isSignedIn();
    }

    match /users/{userId}/sparks/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidSparkUpload();
      allow delete: if isOwner(userId) || isSignedIn();
    }

    // User profile & general media uploads scoped strictly to their own userId folder
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidGeneralMediaType() && isUnder100MB();
      allow delete: if isOwner(userId);
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
