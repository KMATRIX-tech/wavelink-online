rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSafeSparkVideoType() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime|ogg|x-m4v|3gpp)');
    }

    function isSafeSparkImageType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    function isValidSparkDuration() {
      // Images do not have video duration; videos must declare durationSeconds metadata (<= 60s Free, <= 90s Pro)
      return isSafeSparkImageType() || (
        isSafeSparkVideoType() &&
        'durationSeconds' in request.resource.metadata &&
        int(request.resource.metadata.durationSeconds) >= 1 &&
        (
          ('isPro' in request.resource.metadata && request.resource.metadata.isPro == 'true')
            ? int(request.resource.metadata.durationSeconds) <= 90
            : int(request.resource.metadata.durationSeconds) <= 60
        )
      );
    }

    function isValidSparkUpload() {
      // Max 80 MB ceiling and safe video/image MIME types enforced at Storage layer
      return (isSafeSparkVideoType() || isSafeSparkImageType()) &&
             request.resource.size > 0 &&
             request.resource.size <= 80 * 1024 * 1024 &&
             isValidSparkDuration();
    }

    function isValidGeneralMediaType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)') ||
             request.resource.contentType.matches('video/(mp4|webm|quicktime|ogg|x-m4v|3gpp)') ||
             request.resource.contentType.matches('audio/.*');
    }

    function isWithinGeneralSizeLimit() {
      // Max 100 MB ceiling for general Pro video uploads
      return request.resource.size <= 100 * 1024 * 1024;
    }

    // 24-hour Spark uploads scoped to userId with 80 MB cap, safe MIME types, and 60s Free / 90s Pro duration rules
    match /sparks/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidSparkUpload();
      allow delete: if isOwner(userId) || isSignedIn();
    }

    match /users/{userId}/sparks/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidSparkUpload();
      allow delete: if isOwner(userId) || isSignedIn();
    }

    // User profile & general media uploads scoped strictly to their own userId folder
    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isValidGeneralMediaType() && isWithinGeneralSizeLimit();
      allow delete: if isOwner(userId);
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
