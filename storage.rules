rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny-all baseline
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Profile Cover images (<= 5 MB, image/*)
    match /users/{userId}/covers/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Profile Avatar / Photo images (<= 5 MB, image/*)
    match /users/{userId}/avatars/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Custom App / Profile Background images (<= 5 MB, image/*)
    match /users/{userId}/backgrounds/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Per-Chat Custom Background Photos (<= 400 KB, image/*)
    match /users/{userId}/chatThemes/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource != null
        && request.resource.size <= 400 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Feed Post & Reel Media (<= 100 MB video or <= 10 MB image)
    match /posts/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource != null
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/.*') && request.resource.size <= 100 * 1024 * 1024)
        );
      allow delete: if isOwner(userId);
    }

    // 24-Hour Spark Media (<= 80 MB video or <= 10 MB image)
    match /sparks/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource != null
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/.*') && request.resource.size <= 80 * 1024 * 1024)
        );
      allow delete: if isOwner(userId);
    }

    // Direct & Group Chat Media Attachments (<= 100 MB video or <= 10 MB image)
    match /chats/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource != null
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/.*') && request.resource.size <= 100 * 1024 * 1024)
        );
      allow delete: if isOwner(userId);
    }

    // Chat Voice Notes (<= 10 MB audio/*)
    match /voiceNotes/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isOwner(userId);
    }
  }
}
