rules_version = '2';
// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}
//   - uid: string (immutable, matches userId)
//   - email: string (optional, <= 160 chars)
//   - displayName: string (required/optional, <= 80 chars)
//   - username: string (optional, <= 50 chars)
//   - bio: string (optional, <= 500 chars)
//   - role: 'user' | 'sub_admin' | 'super_admin' (protected against self-escalation)
//   - isSubAdmin: bool (protected against self-escalation)
//   - isBanned: bool (protected against self-unbanning)
//   - wavePoints / points: number (bounded increments per check-in/spark reward)
//
// Collection: posts/{postId}
//   - id: string
//   - authorId: string (immutable, matches request.auth.uid or wavelink_support_bot for admins)
//   - content: string (<= 4000 chars)
//   - likes: list, likesCount: number, reactions: map, reactionCounts: map, commentsCount: number
//   - createdAt: string (immutable ISO timestamp)
//
// Subcollection: posts/{postId}/comments/{commentId}
//   - postId: string, authorId: string (immutable, matches request.auth.uid)
//   - content: string (1..2000 chars), createdAt: string (immutable)
//
// Collection: sparks/{sparkId}
//   - id: string, authorId: string (immutable, matches request.auth.uid)
//   - caption: string (<= 600 chars), mediaType: 'image' | 'video'
//   - videoDurationSeconds: number (<= 60.5s Free, <= 90.5s Pro), videoFileSize: number (<= 80MB)
//   - likes, likesCount, likedUsers, viewers, viewersCount, viewerUsers: engagement fields
//   - createdAt: string (immutable), expiresAt: string (immutable 24h expiry)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper & Validator Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-@.:]+$');
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    // Single source of truth for admin role across Admin Desk, Server Routes, and Firestore Rules:
    // Checks Firebase custom claims (token.role == 'admin' / token.admin == true), /users/{uid}.role, and /admins/{uid}
    function isOwnerEmailToken() {
      return isSignedIn() &&
        request.auth.token.get('email', '') is string &&
        request.auth.token.get('email', '').lower() == 'keylanmbilinyi5@gmail.com';
    }

    function hasAdminCustomClaim() {
      return isSignedIn() && (
        isOwnerEmailToken() ||
        request.auth.token.get('role', '') in ['admin', 'super_admin'] ||
        request.auth.token.get('admin', false) == true
      );
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user')
        : request.auth.token.get('role', 'user');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        hasAdminCustomClaim() ||
        getUserRole() in ['admin', 'super_admin'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isOwner', false) == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSubAdmin() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'sub_admin' ||
        getUserRole() == 'sub_admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSubAdmin', false) == true &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBot', false) != true)
      );
    }

    function isAdmin() {
      return isSuperAdmin() || isSubAdmin();
    }

    // Verify if the authenticated user is strictly one of the two participants in a Direct Message conversation (`dm_<uidA>_<uidB>`)
    function isDmParticipant(channelId) {
      return isSignedIn() && (
        channelId == 'dm_' + request.auth.uid ||
        channelId.matches('^dm_' + request.auth.uid + '_.*$') ||
        channelId.matches('^dm_.*_' + request.auth.uid + '$') ||
        (exists(/databases/$(database)/documents/channels/$(channelId)) &&
         request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.get('participants', []))
      );
    }

    function isDmMember(channelId) {
      return isSignedIn() && (
        (channelId == 'official_updates') ||
        isDmParticipant(channelId)
      );
    }

    // Verify if the authenticated user is a member of a Group (`groups/{groupId}`)
    function isGroupMember(groupId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/groups/$(groupId)) &&
         request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds) ||
        isAdmin()
      );
    }

    // Validate User Profile payload lengths & types (used on both create and update)
    function isValidUserProfilePayload(data) {
      return isValidOptionalString(data, 'displayName', 80) &&
        isValidOptionalString(data, 'username', 50) &&
        isValidOptionalString(data, 'bio', 500) &&
        isValidOptionalString(data, 'email', 160) &&
        isValidOptionalString(data, 'photoURL', 150000) &&
        isValidOptionalString(data, 'coverImageUrl', 4096) &&
        isValidOptionalString(data, 'coverPresetId', 80) &&
        isValidOptionalString(data, 'coverType', 32) &&
        isValidOptionalString(data, 'pinnedPostId', 160) &&
        isValidOptionalString(data, 'appearanceTheme', 40) &&
        isValidOptionalString(data, 'language', 16) &&
        isValidOptionalString(data, 'panAfricanLanguage', 24) &&
        isValidOptionalString(data, 'countryCode', 12) &&
        isValidOptionalString(data, 'regionName', 80) &&
        isValidOptionalString(data, 'preferredCurrency', 12) &&
        isValidOptionalString(data, 'patternFrame', 32) &&
        isValidOptionalString(data, 'proBorderEffect', 32) &&
        isValidOptionalString(data, 'proAccentColor', 32) &&
        isValidOptionalString(data, 'proBadge', 32) &&
        (!('chatThemes' in data) || (data.chatThemes is map && data.chatThemes.size() <= 200)) &&
        (!('coverImageUrl' in data) || !(data.coverImageUrl is string) || !data.coverImageUrl.matches('^data:.*'));
    }

    // Check if the authenticated user is a Pro member, verified by Admin, or an Admin
    function isUserProOrAdmin() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isPro', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('hasBlueStar', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isVerifiedByAdmin', false) == true
        )
      );
    }

    // Protect RBAC, contact verification flags, Pro status, badges, and points from unauthorized client self-escalation
    function isSafeUserProfileCreate(userId) {
      let data = request.resource.data;
      return isOwner(userId) &&
        isValidUserProfilePayload(data) &&
        (!('uid' in data) || data.uid == userId) &&
        (!('role' in data) || data.role == 'user' || isSuperAdmin()) &&
        (!('admin' in data) || data.admin == false || isSuperAdmin()) &&
        (!('isOwner' in data) || data.isOwner == false || isSuperAdmin()) &&
        (!('isSubAdmin' in data) || data.isSubAdmin == false || isSuperAdmin()) &&
        (!('isBot' in data) || data.isBot == false) &&
        (!('isBanned' in data) || data.isBanned == false) &&
        (!('isPro' in data) || data.isPro == false || isAdmin()) &&
        (!('hasBlueStar' in data) || data.hasBlueStar == false || isAdmin()) &&
        (!('isVerifiedByAdmin' in data) || data.isVerifiedByAdmin == false || isAdmin()) &&
        (!('emailVerified' in data) || data.emailVerified == isEmailVerified()) &&
        (!('phoneVerified' in data) || data.phoneVerified == false) &&
        (!('isContactVerified' in data) || data.isContactVerified == isEmailVerified()) &&
        (!('points' in data) || (data.points is number && data.points >= 0 && data.points <= 50)) &&
        (!('wavePoints' in data) || (data.wavePoints is number && data.wavePoints >= 0 && data.wavePoints <= 50));
    }

    // Users can update ONLY their own safe profile fields (photo, cover, bio, displayName, username, theme, language, settings),
    // and NEVER role, admin, sub-admin, Pro, verified badges, ban state, or points.
    function isSafeUserProfileUpdate(userId) {
      let incoming = request.resource.data;
      let existing = resource.data;
      return isOwner(userId) &&
        isValidUserProfilePayload(incoming) &&
        (!('uid' in incoming) || incoming.uid == userId) &&
        !incoming.diff(existing).affectedKeys().hasAny([
          'role',
          'admin',
          'isSubAdmin',
          'isPro',
          'hasBlueStar',
          'isVerifiedByAdmin',
          'isOwner',
          'isBanned',
          'points',
          'wavePoints',
          'isBot',
          '_serverGrantKey',
          'emailVerified',
          'phoneVerified',
          'isContactVerified'
        ]);
    }

    // Validate Feed Post payload on create & update (never allow base64 video in Firestore; enforce 60s Free / 90s Pro duration)
    function isValidPostPayload(data) {
      return ('authorId' in data) && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        isValidOptionalString(data, 'content', 4000) &&
        isValidOptionalString(data, 'authorName', 100) &&
        isValidOptionalString(data, 'authorUsername', 60) &&
        (!('videoUrl' in data) || !(data.videoUrl is string) || !data.videoUrl.matches('^data:video/.*')) &&
        (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
        (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0)) &&
        (!('duration' in data) || (
          data.duration is number &&
          data.duration >= 0 &&
          (isUserProOrAdmin() ? data.duration <= 90.5 : data.duration <= 60.5)
        )) &&
        (!('videoDurationSeconds' in data) || (
          data.videoDurationSeconds is number &&
          data.videoDurationSeconds >= 0 &&
          (isUserProOrAdmin() ? data.videoDurationSeconds <= 90.5 : data.videoDurationSeconds <= 60.5)
        ));
    }

    // Validate Post Comment payload on create & update
    function isValidCommentPayload(data) {
      return ('authorId' in data) && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        ('content' in data) && data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
        isValidOptionalString(data, 'authorName', 100);
    }

    // Default catch-all deny rule for zero-trust baseline
    match /{document=**} {
      allow read, write: if false;
    }

    // Server-managed Admins registry (writable by custom-claim admin or by server after verifying OWNER_EMAIL and OWNER_ACCESS_CODE)
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow create, update: if isSuperAdmin() || (
        isOwner(adminId) &&
        request.resource.data.uid == adminId &&
        request.resource.data.role in ['admin', 'super_admin'] &&
        request.resource.data.get('_serverGrantKey', '') == 'wvlk_srv_grant_9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c'
      );
      allow delete: if isSuperAdmin();
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Check if update/create is a server-verified owner admin role grant
    function isServerVerifiedOwnerRoleGrant(userId) {
      return isOwner(userId) &&
        request.resource.data.get('role', '') in ['admin', 'super_admin'] &&
        request.resource.data.get('_serverGrantKey', '') == 'wvlk_srv_grant_9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c';
    }

    // User profiles: users can read directory profiles, create/update only their own (with RBAC/Pro/points guards), or delete their own account
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && (isAdmin() || isServerVerifiedOwnerRoleGrant(userId) || isSafeUserProfileCreate(userId));
      allow update: if isValidId(userId) && (isAdmin() || isServerVerifiedOwnerRoleGrant(userId) || isSafeUserProfileUpdate(userId));
      allow delete: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());

      // Device FCM Push Notification Tokens — strictly private to the user & admin
      match /fcmTokens/{tokenId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin()) &&
          request.resource.data.keys().hasAll(['token', 'userId']) &&
          request.resource.data.userId == userId &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 0 &&
          request.resource.data.token.size() <= 1024;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Private Saved Posts subcollection — strictly private to the user & admin
      match /savedPosts/{savedPostId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Phase 5: Private Creator Stats subcollection — strictly only the owner of the account can see or update their own stats
      match /privateStats/{statDocId} {
        allow read, write: if isOwner(userId);
      }

      // Per-Chat Theme Preferences subcollection — strictly only the owning user can read/write their own chat settings
      match /chatSettings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Phase 5: Top-level Private Creator Stats collection — strictly only the owner of the account can see their own stats
    match /creatorStats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Phase 4: Weekly Creator Challenges — readable by everyone, created/updated/deleted by Admins
    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Creator Spotlight of the Week — readable by everyone, chosen/updated by Admins
    match /creatorSpotlights/{spotlightId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Top-level private 'Saved Posts' collection: readable and writable only by the authenticated owner or admin
    match /savedPosts/{savedPostId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Social feed posts (includes approved scheduled bot posts when triggered by an admin)
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidPostPayload(request.resource.data) && (
        request.resource.data.authorId == request.auth.uid ||
        (request.resource.data.authorId == 'wavelink_support_bot' && isAdmin())
      );
      allow update: if isSignedIn() && isValidPostPayload(request.resource.data) && (
        (resource.data.authorId == request.auth.uid && areImmutableFieldsUnchanged(['authorId', 'createdAt'])) ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes',
          'likesCount',
          'reactions',
          'reactionCounts',
          'commentsCount',
          'savesCount',
          'sharesCount',
          'sharedBy',
          'tipsTotalTZS',
          'isBoosted',
          'updatedAt'
        ])
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          isValidCommentPayload(request.resource.data) &&
          request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn() &&
          isValidCommentPayload(request.resource.data) &&
          areImmutableFieldsUnchanged(['authorId', 'postId', 'createdAt']) &&
          (
            resource.data.authorId == request.auth.uid ||
            isAdmin() ||
            (
              areImmutableFieldsUnchanged(['content']) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reactionCounts', 'updatedAt'])
            )
          );
        allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }

      match /chunks/{chunkId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (
          isAdmin() ||
          (exists(/databases/$(database)/documents/posts/$(postId)) &&
           get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid)
        );
      }
    }

    // Validate Spark payload: never allow base64 video in Firestore, enforce caption size, and enforce 60s Free / 90s Pro duration limits
    function isValidSparkPayload() {
      let data = request.resource.data;
      return ('authorId' in data) && data.authorId is string && data.authorId.size() <= 128 &&
        isValidOptionalString(data, 'caption', 600) &&
        isValidOptionalString(data, 'legendaryTag', 80) &&
        (!('mediaUrl' in data) || !(data.mediaUrl is string) || !data.mediaUrl.matches('^data:video/.*')) &&
        (!('videoDurationSeconds' in data) || (
          data.videoDurationSeconds is number &&
          data.videoDurationSeconds >= 0 &&
          (isUserProOrAdmin() ? data.videoDurationSeconds <= 90.5 : data.videoDurationSeconds <= 60.5)
        )) &&
        (!('videoFileSize' in data) || (data.videoFileSize is number && data.videoFileSize <= 80 * 1024 * 1024));
    }

    // Sparks: 24-hour ephemeral moments (includes approved Spark of the Day from WaveLink Support Bot)
    match /sparks/{sparkId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidSparkPayload() && (
        request.resource.data.authorId == request.auth.uid ||
        (request.resource.data.authorId == 'wavelink_support_bot' && isAdmin())
      );
      allow update: if isSignedIn() && isValidSparkPayload() && (
        (resource.data.authorId == request.auth.uid && areImmutableFieldsUnchanged(['authorId', 'createdAt'])) ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes',
          'likesCount',
          'likedUsers',
          'viewers',
          'viewersCount',
          'viewerUsers'
        ])
      );
      // Only the Spark owner or an Admin can delete a Spark
      allow delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );

      match /chunks/{chunkId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (
          isAdmin() ||
          (exists(/databases/$(database)/documents/sparks/$(sparkId)) &&
           get(/databases/$(database)/documents/sparks/$(sparkId)).data.authorId == request.auth.uid)
        );
      }
    }

    // Global Announcements & Community Notice Board Events
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.authorId == request.auth.uid ||
        (request.resource.data.authorId == 'wavelink_support_bot' && isAdmin())
      );
      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid && areImmutableFieldsUnchanged(['authorId', 'createdAt'])) ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpUserIds', 'rsvpCount'])
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn();
      }
    }

    // Support Tickets & Complaints (readable/writable only by ticket owner or Admin)
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // WaveLink Support Bot Config (readable by signed-in users, editable only by Admins)
    match /supportBotConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // WaveLink Support Bot Conversation Logs & Bad Reply Reports
    match /supportBotLogs/{logId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBadReply', 'reportReason', 'escalatedToTicketId']))
      );
      allow delete: if isAdmin();
    }

    // Scheduled Bot Drafts (Weekly Community Update & Spark of the Day — Admin managed)
    match /scheduledBotDrafts/{draftId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Content & User Reports (Posts, Accounts, Bad Bot Replies)
    match /contentReports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admin Security Audit Log (Bans, Role Changes, Verifications, Deletions)
    match /adminAuditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && (isAdmin() || request.resource.data.actorId == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }

    // Helper: check if the authenticated user is a Group Admin or Creator (or platform Admin)
    function isGroupAdmin(groupId) {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/groups/$(groupId)) && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.get('adminIds', [])
        ))
      );
    }

    // Helper: verify group suggestedTheme updates:
    // - Group admins/creator can set or clear suggestedTheme
    // - Non-admin group members can only accept/decline an existing suggestion without altering its theme or suggester
    function isValidGroupSuggestedThemeUpdate(groupId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['suggestedTheme']) ||
        isGroupAdmin(groupId) || (
          isGroupMember(groupId) &&
          resource.data.suggestedTheme != null &&
          request.resource.data.suggestedTheme != null &&
          request.resource.data.suggestedTheme.themeId == resource.data.suggestedTheme.themeId &&
          request.resource.data.suggestedTheme.suggestedBy == resource.data.suggestedTheme.suggestedBy &&
          request.resource.data.suggestedTheme.suggestedAt == resource.data.suggestedTheme.suggestedAt
        );
    }

    // User-created groups & group messages (Chats & suggested group themes readable/writable only by group members)
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isGroupMember(groupId) && isValidGroupSuggestedThemeUpdate(groupId);
      allow delete: if isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isGroupMember(groupId) && (
          resource.data.senderId == request.auth.uid ||
          isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'lastSeenAt'])
        );
        allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // Real-Time Direct Messages & Official Updates Channel (Strictly only conversation participants can read/write metadata or shared themes)
    match /channels/{channelId} {
      allow get: if isDmMember(channelId);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow write: if channelId == 'official_updates' ? isAdmin() : (
        isDmMember(channelId) ||
        (isSignedIn() && request.auth.uid in request.resource.data.get('participants', []))
      );

      match /messages/{messageId} {
        allow read: if isDmMember(channelId) || (
          isSignedIn() &&
          resource != null && (
            resource.data.get('senderId', '') == request.auth.uid ||
            resource.data.get('receiverId', '') == request.auth.uid ||
            request.auth.uid in resource.data.get('participants', [])
          )
        );
        allow create: if (
          isDmMember(channelId) ||
          (isSignedIn() && request.auth.uid in request.resource.data.get('participants', []))
        ) && (
          (request.resource.data.senderId == request.auth.uid && (channelId != 'official_updates' || isAdmin())) ||
          (request.resource.data.senderId == 'wavelink_support_bot' && channelId.matches('.*wavelink_support_bot.*'))
        );
        allow update: if isDmMember(channelId) && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'lastSeenAt', 'reportedBadReply'])
        );
        allow delete: if isDmMember(channelId) && resource.data.senderId == request.auth.uid;
      }
    }

    // Conversations collection alias (strictly only conversation participants can read and create messages)
    match /conversations/{conversationId} {
      allow read: if isDmMember(conversationId) || (
        isSignedIn() && resource != null && request.auth.uid in resource.data.get('participants', [])
      );
      allow create, update: if isDmMember(conversationId) || (
        isSignedIn() && request.auth.uid in request.resource.data.get('participants', [])
      );

      match /messages/{messageId} {
        allow read: if isDmMember(conversationId) || (
          isSignedIn() &&
          resource != null && (
            resource.data.get('senderId', '') == request.auth.uid ||
            resource.data.get('receiverId', '') == request.auth.uid ||
            request.auth.uid in resource.data.get('participants', [])
          )
        );
        allow create: if (
          isDmMember(conversationId) ||
          (isSignedIn() && request.auth.uid in request.resource.data.get('participants', []))
        ) && request.resource.data.senderId == request.auth.uid;
        allow update: if isDmMember(conversationId) && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'lastSeenAt'])
        );
        allow delete: if isDmMember(conversationId) && resource.data.senderId == request.auth.uid;
      }
    }

    // Global App Settings (video/voice call locks)
    match /appSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subscriptions and mobile payment transactions
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Payment Gateway Developer Settings (Client IDs, Secrets, Webhook)
    match /paymentConfig/{configId} {
      allow read, write: if isSuperAdmin();
    }

    // In-App Notifications (messages, calls, posts, follows)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOptionalString(request.resource.data, 'body', 600);
      allow update: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // User Follows
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.followerId == request.auth.uid || isAdmin());
    }

    // Manual Mobile Money Transaction Verifications for WaveLink Pro
    match /pending_verifications/{verificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Direct Manual Payment Requests for WaveLink Pro & Harvest Pass (Private to submitting user & admins)
    match /payment_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // System Domains for OAuth Whitelisting tracking
    match /system_domains/{domainId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Official Coupon & Promo Codes
    match /coupons/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promo_codes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI-Collected Platform Upgrades & Feature Feedback (from Welink AI, Live Talk, and Support Bot)
    match /upgrade_feedback/{feedbackId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.submittedByUserId == request.auth.uid);
      allow create: if isSignedIn() && isValidOptionalString(request.resource.data, 'rawSuggestion', 2000);
      allow update, delete: if isAdmin();
    }

    // Live Video & Voice Calls (Strictly only the caller and the receiver can read and update the call and its ICE candidate subcollections)
    function isCallParticipantData(d) {
      return d != null && (
        d.get('callerId', '') == request.auth.uid ||
        d.get('receiverId', '') == request.auth.uid ||
        d.get('caller', '') == request.auth.uid ||
        d.get('receiver', '') == request.auth.uid
      );
    }

    function isCallParticipant(callId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/calls/$(callId)) &&
        isCallParticipantData(get(/databases/$(database)/documents/calls/$(callId)).data);
    }

    match /calls/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && (
        resource == null || isCallParticipantData(resource.data)
      );
      allow list: if isSignedIn() && isCallParticipantData(resource.data);
      allow create: if isSignedIn() &&
        isValidId(callId) &&
        (request.resource.data.get('callerId', '') == request.auth.uid ||
         request.resource.data.get('caller', '') == request.auth.uid) &&
        ((request.resource.data.get('receiverId', '') is string && request.resource.data.get('receiverId', '').size() > 0) ||
         (request.resource.data.get('receiver', '') is string && request.resource.data.get('receiver', '').size() > 0));
      allow update: if isSignedIn() &&
        isValidId(callId) &&
        resource != null &&
        isCallParticipantData(resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['caller', 'callerId', 'receiver', 'receiverId']);
      allow delete: if isSignedIn() &&
        isValidId(callId) &&
        resource != null &&
        isCallParticipantData(resource.data);

      match /callerCandidates/{candidateId} {
        allow get, create, update, delete: if isValidId(candidateId) && isCallParticipant(callId);
        allow list: if isCallParticipant(callId);
      }

      match /calleeCandidates/{candidateId} {
        allow get, create, update, delete: if isValidId(candidateId) && isCallParticipant(callId);
        allow list: if isCallParticipant(callId);
      }
    }
  }
}
