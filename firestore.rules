rules_version = '2';
// ===============================================================
// WaveLink Security Rules (Hardened Component-by-Component Audit)
// ===============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper & Validator Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-@.:]+$');
    }

    function isValidTokenId(id) {
      return id is string && id.size() >= 1 && id.size() <= 512 && id.matches('^[a-zA-Z0-9_\\-@.:]+$');
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidStringList(data, field, maxItems) {
      return !(field in data) || data[field] == null || (data[field] is list && data[field].size() <= maxItems);
    }

    // Platform owner identity (must be verified email token)
    function isOwnerEmailToken() {
      return isSignedIn() && (
        ('email' in request.auth.token &&
          request.auth.token.email is string &&
          request.auth.token.email.lower() == 'keylanmbilinyi5@gmail.com') ||
        (request.auth.token.get('email', '') is string &&
          request.auth.token.get('email', '').lower() == 'keylanmbilinyi5@gmail.com')
      );
    }

    function hasAdminCustomClaim() {
      return isSignedIn() && (
        (isOwnerEmailToken() && isEmailVerified()) ||
        request.auth.token.get('role', '') in ['admin', 'super_admin'] ||
        request.auth.token.get('admin', false) == true
      );
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return hasUserDoc()
        ? getUserDoc().data.get('role', 'user')
        : request.auth.token.get('role', 'user');
    }

    function hasRoleDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }

    function getRoleDocValue() {
      return hasRoleDoc()
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('role', 'user')
        : 'user';
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        hasAdminCustomClaim() ||
        getRoleDocValue() == 'admin' ||
        getUserRole() in ['admin', 'super_admin'] ||
        (hasUserDoc() && getUserDoc().data.get('isOwner', false) == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSubAdmin() {
      return isSignedIn() && (
        getRoleDocValue() in ['subadmin', 'sub_admin'] ||
        request.auth.token.get('role', '') in ['sub_admin', 'subadmin', 'moderator'] ||
        getUserRole() in ['sub_admin', 'subadmin', 'moderator'] ||
        (hasUserDoc() &&
         (getUserDoc().data.get('isSubAdmin', false) == true || getUserDoc().data.get('isModerator', false) == true) &&
         getUserDoc().data.get('isBot', false) != true)
      );
    }

    function isModerator() {
      return isSubAdmin();
    }

    function isSupportHelper() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'support_helper' ||
        getUserRole() == 'support_helper' ||
        (hasUserDoc() &&
         getUserDoc().data.get('isSupportHelper', false) == true &&
         getUserDoc().data.get('isBot', false) != true)
      );
    }

    function isAdmin() {
      return isSuperAdmin() || isSubAdmin();
    }

    function isStaff() {
      return isAdmin() || isSupportHelper();
    }

    function isNotRestrictedTimestamp(data, field) {
      return !(field in data) || data[field] == null || !(data[field] is number) || data[field] <= request.time.toMillis();
    }

    function isNotBanned() {
      return isSignedIn() && (
        !hasUserDoc() || (
          getUserDoc().data.get('isBanned', false) != true &&
          isNotRestrictedTimestamp(getUserDoc().data, 'suspendedUntilMs') &&
          isNotRestrictedTimestamp(getUserDoc().data, 'mutedUntilMs')
        )
      );
    }

    // Verify if the authenticated user is strictly one of the two participants in a Direct Message conversation (`dm_<uidA>_<uidB>`)
    function isDmParticipant(channelId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/channels/$(channelId)) &&
        get(/databases/$(database)/documents/channels/$(channelId)).data.get('participants', []).size() > 0
          ? (request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.get('participants', []))
          : (
              channelId == 'dm_' + request.auth.uid ||
              channelId.matches('^dm_' + request.auth.uid + '_[^_]+$') ||
              channelId.matches('^dm_[^_]+_' + request.auth.uid + '$') ||
              channelId.matches('^dm_' + request.auth.uid + '_wavelink_support_bot$') ||
              channelId.matches('^dm_wavelink_support_bot_' + request.auth.uid + '$')
            )
      );
    }

    function isDmMember(channelId) {
      return isSignedIn() && (
        (channelId == 'official_updates') ||
        isDmParticipant(channelId)
      );
    }

    // Verify if the authenticated user is a member of a Group (`groups/{groupId}`)
    function isGroupMember(groupId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/groups/$(groupId)) &&
         request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.get('memberIds', [])) ||
        isAdmin()
      );
    }

    // Helper: check if the authenticated user is a Group Admin or Owner/Creator (or platform Admin)
    function isGroupAdmin(groupId) {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/groups/$(groupId)) && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.get('creatorId', '') == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.get('adminIds', [])
        ))
      );
    }

    function isGroupOwner(groupId) {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/groups/$(groupId)) &&
         get(/databases/$(database)/documents/groups/$(groupId)).data.get('creatorId', '') == request.auth.uid)
      );
    }

    function isValidCustomBackgroundUrl(val) {
      return val is string &&
        val.size() > 10 &&
        val.size() <= 1024 &&
        val.matches('^https://.*') &&
        !val.matches('^data:.*') &&
        !val.matches('^blob:.*');
    }

    function isValidCustomBackgroundItem(bg) {
      return bg is map &&
        ('url' in bg) && isValidCustomBackgroundUrl(bg.url) &&
        (!('mobileUrl' in bg) || bg.mobileUrl == null || bg.mobileUrl == '' || isValidCustomBackgroundUrl(bg.mobileUrl)) &&
        ('darken' in bg) && bg.darken is number && bg.darken >= 0 && bg.darken <= 70 &&
        ('blur' in bg) && bg.blur is number && bg.blur >= 0 && bg.blur <= 12 &&
        ('textMode' in bg) && bg.textMode in ['light', 'dark'];
    }

    function isValidCustomBackgroundHistory(hist) {
      return hist == null || (
        hist is list &&
        hist.size() <= 5 &&
        (hist.size() < 1 || isValidCustomBackgroundItem(hist[0])) &&
        (hist.size() < 2 || isValidCustomBackgroundItem(hist[1])) &&
        (hist.size() < 3 || isValidCustomBackgroundItem(hist[2])) &&
        (hist.size() < 4 || isValidCustomBackgroundItem(hist[3])) &&
        (hist.size() < 5 || isValidCustomBackgroundItem(hist[4]))
      );
    }

    function isValidFcmTokenEntry(entry) {
      return entry is map &&
        ('token' in entry) && entry.token is string && entry.token.size() > 10 && entry.token.size() <= 1024 &&
        (!('deviceId' in entry) || entry.deviceId == null || (entry.deviceId is string && entry.deviceId.size() <= 128)) &&
        (!('deviceName' in entry) || entry.deviceName == null || (entry.deviceName is string && entry.deviceName.size() <= 120)) &&
        (!('platform' in entry) || entry.platform == null || (entry.platform is string && entry.platform.size() <= 80)) &&
        (!('createdAt' in entry) || entry.createdAt == null || (entry.createdAt is string && entry.createdAt.size() <= 64)) &&
        (!('lastUsedAt' in entry) || entry.lastUsedAt == null || (entry.lastUsedAt is string && entry.lastUsedAt.size() <= 64));
    }

    function isValidFcmTokensArray(arr) {
      return arr == null || (
        arr is list &&
        arr.size() <= 5 &&
        (arr.size() < 1 || isValidFcmTokenEntry(arr[0])) &&
        (arr.size() < 2 || isValidFcmTokenEntry(arr[1])) &&
        (arr.size() < 3 || isValidFcmTokenEntry(arr[2])) &&
        (arr.size() < 4 || isValidFcmTokenEntry(arr[3])) &&
        (arr.size() < 5 || isValidFcmTokenEntry(arr[4]))
      );
    }

    function isValidPrivacySettings(p) {
      return p == null || (
        p is map &&
        (!('allowDirectMessages' in p) || p.allowDirectMessages == null || p.allowDirectMessages in ['everyone', 'followers', 'none']) &&
        (!('allowCalls' in p) || p.allowCalls == null || p.allowCalls in ['everyone', 'followers', 'none']) &&
        (!('whoCanFollow' in p) || p.whoCanFollow == null || p.whoCanFollow in ['everyone', 'followers', 'none']) &&
        (!('onlineStatusAudience' in p) || p.onlineStatusAudience == null || p.onlineStatusAudience in ['everyone', 'followers', 'close_friends', 'nobody']) &&
        (!('profileVisibility' in p) || p.profileVisibility == null || p.profileVisibility in ['public', 'followers', 'private', 'everyone', 'nobody']) &&
        (!('sparkVisibility' in p) || p.sparkVisibility == null || p.sparkVisibility in ['everyone', 'followers', 'close_friends']) &&
        (!('whoCanComment' in p) || p.whoCanComment == null || p.whoCanComment in ['everyone', 'followers', 'none']) &&
        (!('showLastSeen' in p) || p.showLastSeen == null || p.showLastSeen is bool) &&
        (!('showOnlineStatus' in p) || p.showOnlineStatus == null || p.showOnlineStatus is bool) &&
        (!('showReadReceipts' in p) || p.showReadReceipts == null || p.showReadReceipts is bool) &&
        (!('showTypingIndicator' in p) || p.showTypingIndicator == null || p.showTypingIndicator is bool) &&
        (!('showAchievementsAndChallenges' in p) || p.showAchievementsAndChallenges == null || p.showAchievementsAndChallenges is bool) &&
        (!('isTeenAccount' in p) || p.isTeenAccount == null || p.isTeenAccount is bool)
      );
    }

    function isValidChatNote(note) {
      return note == null || (
        note is map &&
        ('text' in note) && note.text is string && note.text.size() >= 1 && note.text.size() <= 60 &&
        (!('createdAt' in note) || note.createdAt == null || (note.createdAt is string && note.createdAt.size() <= 64)) &&
        (!('expiresAt' in note) || note.expiresAt == null || (note.expiresAt is string && note.expiresAt.size() <= 64))
      );
    }

    // Validate full User Profile payload lengths & types on create
    function isValidUserProfilePayload(data) {
      return isValidOptionalString(data, 'displayName', 80) &&
        isValidOptionalString(data, 'username', 50) &&
        isValidOptionalString(data, 'bio', 500) &&
        isValidOptionalString(data, 'email', 160) &&
        isValidOptionalString(data, 'photoURL', 150000) &&
        isValidOptionalString(data, 'avatar', 1024) &&
        isValidOptionalString(data, 'coverImageUrl', 4096) &&
        isValidOptionalString(data, 'coverPresetId', 80) &&
        isValidOptionalString(data, 'coverType', 32) &&
        isValidOptionalString(data, 'pinnedPostId', 160) &&
        isValidOptionalString(data, 'appearanceTheme', 40) &&
        isValidOptionalString(data, 'language', 16) &&
        isValidOptionalString(data, 'panAfricanLanguage', 24) &&
        isValidOptionalString(data, 'countryCode', 12) &&
        isValidOptionalString(data, 'regionName', 80) &&
        isValidOptionalString(data, 'preferredCurrency', 12) &&
        isValidOptionalString(data, 'patternFrame', 32) &&
        isValidOptionalString(data, 'proBorderEffect', 32) &&
        isValidOptionalString(data, 'proAccentColor', 32) &&
        isValidOptionalString(data, 'proBadge', 32) &&
        isValidOptionalString(data, 'invitedByUid', 128) &&
        isValidOptionalString(data, 'lastSeenUpdateAt', 64) &&
        (!('chatThemes' in data) || data.chatThemes == null || (data.chatThemes is map && data.chatThemes.size() <= 200)) &&
        (!('fcmTokens' in data) || isValidFcmTokensArray(data.fcmTokens)) &&
        isValidStringList(data, 'mutedChannelIds', 200) &&
        isValidStringList(data, 'followingIds', 500) &&
        isValidStringList(data, 'contactIds', 500) &&
        isValidStringList(data, 'pinnedChannelIds', 100) &&
        isValidStringList(data, 'archivedChannelIds', 200) &&
        isValidStringList(data, 'blockedUserIds', 500) &&
        isValidStringList(data, 'mutedUserIds', 500) &&
        isValidStringList(data, 'closeFriendIds', 500) &&
        isValidStringList(data, 'savedPostIds', 500) &&
        isValidStringList(data, 'interests', 30) &&
        isValidStringList(data, 'highlightedBadges', 3) &&
        isValidOptionalString(data, 'highlightedBadgeId', 80) &&
        (!('chatNote' in data) || isValidChatNote(data.chatNote)) &&
        (!('showChatNotes' in data) || data.showChatNotes == null || data.showChatNotes is bool) &&
        (!('chatUnreadFirst' in data) || data.chatUnreadFirst == null || data.chatUnreadFirst is bool) &&
        (!('interestsCompleted' in data) || data.interestsCompleted == null || data.interestsCompleted is bool) &&
        (!('hideAiGenerated' in data) || data.hideAiGenerated == null || data.hideAiGenerated is bool) &&
        (!('sensitiveContentFilter' in data) || data.sensitiveContentFilter == null || data.sensitiveContentFilter is bool) &&
        (!('isUnder18' in data) || data.isUnder18 == null || data.isUnder18 is bool) &&
        (!('birthYear' in data) || data.birthYear == null || (data.birthYear is number && data.birthYear >= 1900 && data.birthYear <= 2100)) &&
        (!('birthMonth' in data) || data.birthMonth == null || (data.birthMonth is number && data.birthMonth >= 1 && data.birthMonth <= 12)) &&
        isValidOptionalString(data, 'turns18At', 16) &&
        (!('parentalStatus' in data) || data.parentalStatus == null || data.parentalStatus in ['none', 'unverified_teen']) &&
        isValidOptionalString(data, 'guidelinesAcceptedAt', 64) &&
        isValidOptionalString(data, 'guidelinesVersion', 32) &&
        (!('termsAgreement' in data) || data.termsAgreement == null || data.termsAgreement is map) &&
        (!('notificationSettings' in data) || data.notificationSettings == null || data.notificationSettings is map) &&
        (!('privacySettings' in data) || isValidPrivacySettings(data.privacySettings)) &&
        (!('customThemeMix' in data) || data.customThemeMix == null || (data.customThemeMix is map && data.customThemeMix.size() <= 16)) &&
        (!('savedThemeMixes' in data) || data.savedThemeMixes == null || (data.savedThemeMixes is list && data.savedThemeMixes.size() <= 3)) &&
        (!('coverImageUrl' in data) || !(data.coverImageUrl is string) || !data.coverImageUrl.matches('^data:.*')) &&
        (!('customBackground' in data) || data.customBackground == null || isValidCustomBackgroundItem(data.customBackground)) &&
        (!('customBackgroundHistory' in data) || isValidCustomBackgroundHistory(data.customBackgroundHistory));
    }

    // Validate only the fields actually modified in a User Profile update so untouched legacy fields
    // on existing documents do not block valid self-profile updates.
    function isValidUserProfileUpdatePayload(data, changed) {
      return (!changed.hasAny(['displayName']) || isValidOptionalString(data, 'displayName', 80)) &&
        (!changed.hasAny(['username']) || isValidOptionalString(data, 'username', 50)) &&
        (!changed.hasAny(['bio']) || isValidOptionalString(data, 'bio', 500)) &&
        (!changed.hasAny(['email']) || isValidOptionalString(data, 'email', 160)) &&
        (!changed.hasAny(['photoURL']) || isValidOptionalString(data, 'photoURL', 150000)) &&
        (!changed.hasAny(['avatar']) || isValidOptionalString(data, 'avatar', 1024)) &&
        (!changed.hasAny(['coverImageUrl']) || (
          isValidOptionalString(data, 'coverImageUrl', 4096) &&
          (!('coverImageUrl' in data) || !(data.coverImageUrl is string) || !data.coverImageUrl.matches('^data:.*'))
        )) &&
        (!changed.hasAny(['coverPresetId']) || isValidOptionalString(data, 'coverPresetId', 80)) &&
        (!changed.hasAny(['coverType']) || isValidOptionalString(data, 'coverType', 32)) &&
        (!changed.hasAny(['pinnedPostId']) || isValidOptionalString(data, 'pinnedPostId', 160)) &&
        (!changed.hasAny(['appearanceTheme']) || isValidOptionalString(data, 'appearanceTheme', 40)) &&
        (!changed.hasAny(['language']) || isValidOptionalString(data, 'language', 16)) &&
        (!changed.hasAny(['panAfricanLanguage']) || isValidOptionalString(data, 'panAfricanLanguage', 24)) &&
        (!changed.hasAny(['countryCode']) || isValidOptionalString(data, 'countryCode', 12)) &&
        (!changed.hasAny(['regionName']) || isValidOptionalString(data, 'regionName', 80)) &&
        (!changed.hasAny(['preferredCurrency']) || isValidOptionalString(data, 'preferredCurrency', 12)) &&
        (!changed.hasAny(['patternFrame']) || isValidOptionalString(data, 'patternFrame', 32)) &&
        (!changed.hasAny(['proBorderEffect']) || isValidOptionalString(data, 'proBorderEffect', 32)) &&
        (!changed.hasAny(['proAccentColor']) || isValidOptionalString(data, 'proAccentColor', 32)) &&
        (!changed.hasAny(['proBadge']) || isValidOptionalString(data, 'proBadge', 32)) &&
        (!changed.hasAny(['invitedByUid']) || isValidOptionalString(data, 'invitedByUid', 128)) &&
        (!changed.hasAny(['lastSeenUpdateAt']) || isValidOptionalString(data, 'lastSeenUpdateAt', 64)) &&
        (!changed.hasAny(['chatThemes']) || !('chatThemes' in data) || data.chatThemes == null || (data.chatThemes is map && data.chatThemes.size() <= 200)) &&
        (!changed.hasAny(['fcmTokens']) || !('fcmTokens' in data) || isValidFcmTokensArray(data.fcmTokens)) &&
        (!changed.hasAny(['mutedChannelIds']) || isValidStringList(data, 'mutedChannelIds', 200)) &&
        (!changed.hasAny(['followingIds']) || isValidStringList(data, 'followingIds', 500)) &&
        (!changed.hasAny(['contactIds']) || isValidStringList(data, 'contactIds', 500)) &&
        (!changed.hasAny(['pinnedChannelIds']) || isValidStringList(data, 'pinnedChannelIds', 100)) &&
        (!changed.hasAny(['archivedChannelIds']) || isValidStringList(data, 'archivedChannelIds', 200)) &&
        (!changed.hasAny(['blockedUserIds']) || isValidStringList(data, 'blockedUserIds', 500)) &&
        (!changed.hasAny(['mutedUserIds']) || isValidStringList(data, 'mutedUserIds', 500)) &&
        (!changed.hasAny(['closeFriendIds']) || isValidStringList(data, 'closeFriendIds', 500)) &&
        (!changed.hasAny(['savedPostIds']) || isValidStringList(data, 'savedPostIds', 500)) &&
        (!changed.hasAny(['interests']) || isValidStringList(data, 'interests', 30)) &&
        (!changed.hasAny(['highlightedBadges']) || isValidStringList(data, 'highlightedBadges', 3)) &&
        (!changed.hasAny(['highlightedBadgeId']) || isValidOptionalString(data, 'highlightedBadgeId', 80)) &&
        (!changed.hasAny(['chatNote']) || !('chatNote' in data) || isValidChatNote(data.chatNote)) &&
        (!changed.hasAny(['showChatNotes']) || !('showChatNotes' in data) || data.showChatNotes == null || data.showChatNotes is bool) &&
        (!changed.hasAny(['chatUnreadFirst']) || !('chatUnreadFirst' in data) || data.chatUnreadFirst == null || data.chatUnreadFirst is bool) &&
        (!changed.hasAny(['interestsCompleted']) || !('interestsCompleted' in data) || data.interestsCompleted == null || data.interestsCompleted is bool) &&
        (!changed.hasAny(['hideAiGenerated']) || !('hideAiGenerated' in data) || data.hideAiGenerated == null || data.hideAiGenerated is bool) &&
        (!changed.hasAny(['sensitiveContentFilter']) || !('sensitiveContentFilter' in data) || data.sensitiveContentFilter == null || data.sensitiveContentFilter is bool) &&
        (!changed.hasAny(['isUnder18']) || !('isUnder18' in data) || data.isUnder18 == null || data.isUnder18 is bool) &&
        (!changed.hasAny(['guidelinesAcceptedAt']) || isValidOptionalString(data, 'guidelinesAcceptedAt', 64)) &&
        (!changed.hasAny(['guidelinesVersion']) || isValidOptionalString(data, 'guidelinesVersion', 32)) &&
        (!changed.hasAny(['termsAgreement']) || !('termsAgreement' in data) || data.termsAgreement == null || data.termsAgreement is map) &&
        (!changed.hasAny(['notificationSettings']) || !('notificationSettings' in data) || data.notificationSettings == null || data.notificationSettings is map) &&
        (!changed.hasAny(['privacySettings']) || !('privacySettings' in data) || isValidPrivacySettings(data.privacySettings)) &&
        (!changed.hasAny(['customThemeMix']) || !('customThemeMix' in data) || data.customThemeMix == null || (data.customThemeMix is map && data.customThemeMix.size() <= 16)) &&
        (!changed.hasAny(['savedThemeMixes']) || !('savedThemeMixes' in data) || data.savedThemeMixes == null || (data.savedThemeMixes is list && data.savedThemeMixes.size() <= 3)) &&
        (!changed.hasAny(['customBackground']) || !('customBackground' in data) || data.customBackground == null || isValidCustomBackgroundItem(data.customBackground)) &&
        (!changed.hasAny(['customBackgroundHistory']) || !('customBackgroundHistory' in data) || isValidCustomBackgroundHistory(data.customBackgroundHistory));
    }

    // Check if the authenticated user is a Pro member, verified by Admin, or an Admin
    function isUserProOrAdmin() {
      return isAdmin() || (
        hasUserDoc() && (
          getUserDoc().data.get('isPro', false) == true ||
          getUserDoc().data.get('hasBlueStar', false) == true ||
          getUserDoc().data.get('isVerifiedByAdmin', false) == true
        )
      );
    }

    function isOwnerBootstrapProfile(userId) {
      let data = request.resource.data;
      return isOwner(userId) &&
        isOwnerEmailToken() &&
        isEmailVerified() &&
        data.get('role', 'user') in ['user', 'admin', 'super_admin'] &&
        data.get('isSubAdmin', false) == false;
    }

    // Protect RBAC, contact verification flags, Pro status, badges, followers counts, and points from ANY client self-escalation.
    // Pro status and roles can ONLY be changed by a server function (Firebase Admin SDK).
    function isSafeUserProfileCreate(userId) {
      let data = request.resource.data;
      return isOwner(userId) &&
        isValidUserProfilePayload(data) &&
        (!('uid' in data) || data.uid == userId) &&
        (!('role' in data) || data.role == 'user') &&
        (!('admin' in data) || data.admin == false) &&
        (!('isOwner' in data) || data.isOwner == false) &&
        (!('isSubAdmin' in data) || data.isSubAdmin == false) &&
        (!('isModerator' in data) || data.isModerator == false) &&
        (!('isSupportHelper' in data) || data.isSupportHelper == false) &&
        (!('isBot' in data) || data.isBot == false) &&
        (!('isBanned' in data) || data.isBanned == false) &&
        (!('strikesCount' in data) || data.strikesCount == 0) &&
        (!('strikeLevel' in data) || data.strikeLevel == 'none') &&
        (!('mutedUntilMs' in data) || data.mutedUntilMs == null || data.mutedUntilMs == 0) &&
        (!('suspendedUntilMs' in data) || data.suspendedUntilMs == null || data.suspendedUntilMs == 0) &&
        (!('strikeHistory' in data)) &&
        (
          !(data.get('isUnder18', false) == true || data.get('privacySettings', {}).get('isTeenAccount', false) == true) ||
          (
            data.get('sensitiveContentFilter', true) == true &&
            data.get('parentalStatus', 'unverified_teen') == 'unverified_teen'
          )
        ) &&
        (!('parentalLinkId' in data) || data.parentalLinkId == null) &&
        (!('parentEmailMasked' in data) || data.parentEmailMasked == null) &&
        (!('parentalSettings' in data) || data.parentalSettings == null) &&
        (!('hasLinkedTeens' in data) || data.hasLinkedTeens == false) &&
        (!('isPro' in data) || data.isPro == false) &&
        (!('hasBlueStar' in data) || data.hasBlueStar == false) &&
        (!('isVerifiedByAdmin' in data) || data.isVerifiedByAdmin == false) &&
        (!('proPlan' in data) || data.proPlan == null || data.proPlan == 'free') &&
        (!('proExpiresAt' in data) || data.proExpiresAt == null || data.proExpiresAt == '') &&
        (!('followersCount' in data) || data.followersCount == 0) &&
        (!('followingCount' in data) || data.followingCount == 0) &&
        (!('followerIds' in data) || (data.followerIds is list && data.followerIds.size() == 0)) &&
        (!('customBackground' in data) || data.customBackground == null || isUserProOrAdmin()) &&
        (!('customBackgroundHistory' in data) || data.customBackgroundHistory.size() == 0 || isUserProOrAdmin()) &&
        (!('emailVerified' in data) || data.emailVerified == isEmailVerified()) &&
        (!('phoneVerified' in data) || data.phoneVerified == false) &&
        (!('isContactVerified' in data) || data.isContactVerified == isEmailVerified()) &&
        (!('points' in data) || (data.points is number && data.points >= 0 && data.points <= 50)) &&
        (!('wavePoints' in data) || (data.wavePoints is number && data.wavePoints >= 0 && data.wavePoints <= 50)) &&
        (!('xp' in data) || (data.xp is number && data.xp == 0)) &&
        (!('level' in data) || (data.level is number && data.level == 1)) &&
        (!('streak' in data) || (data.streak is number && data.streak >= 0 && data.streak <= 1)) &&
        (!('longestStreak' in data) || (data.longestStreak is number && data.longestStreak >= 0 && data.longestStreak <= 1)) &&
        (!('badges' in data) || (data.badges is list && data.badges.size() == 0)) &&
        (!('challengeStats' in data)) &&
        (!('recentChallenges' in data));
    }

    // Users can update ONLY their own safe profile fields (photo, cover, bio, displayName, username, theme, language, settings),
    // and NEVER role, admin, sub-admin, Pro, verified badges, follower counts, ban state, or arbitrary points.
    function isSafeUserProfileUpdate(userId) {
      let incoming = request.resource.data;
      let existing = resource.data;
      let changed = incoming.diff(existing).affectedKeys();
      let isProSelf = isAdmin() ||
        existing.get('isPro', false) == true ||
        existing.get('hasBlueStar', false) == true ||
        existing.get('isVerifiedByAdmin', false) == true;
      return isOwner(userId) &&
        isValidUserProfileUpdatePayload(incoming, changed) &&
        (!changed.hasAny(['uid']) || !('uid' in incoming) || incoming.uid == userId) &&
        (
          !changed.hasAny(['customBackground', 'customBackgroundHistory']) ||
          isProSelf ||
          (('customBackground' in incoming) && incoming.customBackground == null && !changed.hasAny(['customBackgroundHistory']))
        ) &&
        (
          !changed.hasAny(['proBadge']) ||
          (
            isProSelf &&
            (!('proBadge' in incoming) || incoming.proBadge == null || incoming.proBadge != 'founder' || isSuperAdmin())
          )
        ) &&
        (
          !(
            existing.get('isUnder18', false) == true ||
            incoming.get('isUnder18', false) == true ||
            existing.get('privacySettings', {}).get('isTeenAccount', false) == true ||
            incoming.get('privacySettings', {}).get('isTeenAccount', false) == true
          ) ||
          incoming.get('sensitiveContentFilter', true) == true
        ) &&
        (!existing.get('isUnder18', false) || incoming.get('isUnder18', true) == true) &&
        // Owner may only dismiss (clear to null) pendingWinnerCelebration, never forge one
        (!changed.hasAny(['pendingWinnerCelebration']) || (('pendingWinnerCelebration' in incoming) && incoming.pendingWinnerCelebration == null)) &&
        !changed.hasAny([
          'role',
          'admin',
          'isOwner',
          'isSubAdmin',
          'isModerator',
          'isSupportHelper',
          'isPro',
          'hasBlueStar',
          'isVerifiedByAdmin',
          'proPlan',
          'proExpiresAt',
          'followersCount',
          'followingCount',
          'followerIds',
          'isBanned',
          'strikesCount',
          'strikeLevel',
          'mutedUntilMs',
          'suspendedUntilMs',
          'strikeHistory',
          'warnings',
          'warningMessage',
          'lastWarningAt',
          'banReason',
          'bannedAt',
          'points',
          'wavePoints',
          'xp',
          'level',
          'streak',
          'longestStreak',
          'daysActive',
          'totalLikesReceived',
          'badges',
          'weeklyWinnerUntil',
          'challengeStats',
          'recentChallenges',
          'xpDailyTracker',
          'isBot',
          '_serverGrantKey',
          'emailVerified',
          'phoneVerified',
          'isContactVerified',
          'birthYear',
          'birthMonth',
          'turns18At',
          'parentalLinkId',
          'parentalStatus',
          'parentEmailMasked',
          'parentalSettings',
          'hasLinkedTeens'
        ]);
    }

    // Admins can moderate user accounts (warnings, strikes, mutes, suspensions, ban status),
    // but CANNOT mutate role or isPro from the client SDK.
    function isAdminModerationUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin() &&
        changed.hasOnly([
          'status',
          'isBanned',
          'banReason',
          'bannedAt',
          'warnings',
          'warningMessage',
          'lastWarningAt',
          'strikesCount',
          'strikeLevel',
          'mutedUntilMs',
          'suspendedUntilMs',
          'strikeHistory',
          'isDuplicateDisabled',
          'mergedIntoUid',
          'disabledAt',
          'keptUntil',
          'disabledReason',
          'updatedAt'
        ]);
    }

    // Check mutual block relationship against an author/user UID
    function isBlockedMutual(otherUid) {
      return isSignedIn() && otherUid is string && otherUid.size() > 0 && (
        (hasUserDoc() && otherUid in getUserDoc().data.get('blockedUserIds', [])) ||
        (exists(/databases/$(database)/documents/users/$(otherUid)) &&
         request.auth.uid in get(/databases/$(database)/documents/users/$(otherUid)).data.get('blockedUserIds', []))
      );
    }

    // Check if the authenticated viewer is allowed to read a Post doc (`public` | `followers` | `close_friends`)
    function canReadPostDoc(postData) {
      let audience = postData.get('audience', 'public');
      let authorId = postData.get('authorId', '');
      return isAdmin() ||
        authorId == request.auth.uid ||
        (
          !isBlockedMutual(authorId) && (
            audience == 'public' ||
            (audience == 'close_friends' &&
              exists(/databases/$(database)/documents/users/$(authorId)) &&
              request.auth.uid in get(/databases/$(database)/documents/users/$(authorId)).data.get('closeFriendIds', [])) ||
            (audience == 'followers' && (
              (hasUserDoc() && authorId in getUserDoc().data.get('followingIds', [])) ||
              exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + authorId))
            ))
          )
        );
    }

    // Validate Feed Post payload on create & update (never allow base64 video in Firestore; enforce 60s Free / 90s Pro duration)
    function isValidPostPayload(data) {
      return ('authorId' in data) && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        isValidOptionalString(data, 'content', 4000) &&
        isValidOptionalString(data, 'authorName', 100) &&
        isValidOptionalString(data, 'authorUsername', 60) &&
        isValidOptionalString(data, 'authorHighlightedBadgeId', 80) &&
        isValidOptionalString(data, 'challengeId', 160) &&
        isValidOptionalString(data, 'challengeHashtag', 80) &&
        isValidOptionalString(data, 'category', 40) &&
        isValidOptionalString(data, 'language', 24) &&
        isValidOptionalString(data, 'taggedAt', 64) &&
        isValidStringList(data, 'keywords', 20) &&
        (!('aiGenerated' in data) || data.aiGenerated == null || data.aiGenerated is bool) &&
        (!('aiConfidence' in data) || data.aiConfidence == null || (data.aiConfidence is number && data.aiConfidence >= 0 && data.aiConfidence <= 1)) &&
        (!('mediaSafety' in data) || data.mediaSafety == null || data.mediaSafety in ['safe', 'borderline']) &&
        (!('audience' in data) || data.audience in ['public', 'followers', 'close_friends']) &&
        (!('videoUrl' in data) || !(data.videoUrl is string) || !data.videoUrl.matches('^data:video/.*')) &&
        (!('likesCount' in data) || (data.likesCount is number && data.likesCount >= 0)) &&
        (!('commentsCount' in data) || (data.commentsCount is number && data.commentsCount >= 0)) &&
        (!('duration' in data) || (
          data.duration is number &&
          data.duration >= 0 &&
          data.duration <= 90.5
        )) &&
        (!('videoDurationSeconds' in data) || (
          data.videoDurationSeconds is number &&
          data.videoDurationSeconds >= 0 &&
          data.videoDurationSeconds <= 90.5
        ));
    }

    // Validate Post Comment payload on create & update
    function isValidCommentPayload(data) {
      return ('authorId' in data) && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        ('content' in data) && data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
        isValidOptionalString(data, 'authorName', 100) &&
        isValidOptionalString(data, 'authorHighlightedBadgeId', 80);
    }

    // Validate Weekly Challenge payload (Admin / Sub-Admin only)
    function isValidChallengePayload(data) {
      return isValidOptionalString(data, 'title', 120) &&
        ('theme' in data) && data.theme is string && data.theme.size() >= 2 && data.theme.size() <= 120 &&
        ('hashtag' in data) && data.hashtag is string && data.hashtag.size() >= 2 && data.hashtag.size() <= 60 &&
        ('description' in data) && data.description is string && data.description.size() >= 2 && data.description.size() <= 2000 &&
        isValidOptionalString(data, 'rules', 2000) &&
        (!('type' in data) || data.type == null || data.type in ['photo', 'video', 'text', 'any']) &&
        isValidOptionalString(data, 'coverImageUrl', 2048) &&
        (!('coverImageUrl' in data) || !(data.coverImageUrl is string) || !data.coverImageUrl.matches('^data:.*')) &&
        isValidOptionalString(data, 'badgeId', 80) &&
        (!('status' in data) || data.status in ['active', 'completed']) &&
        (!('maxEntriesPerUser' in data) || data.maxEntriesPerUser == null || (data.maxEntriesPerUser is number && data.maxEntriesPerUser >= 1 && data.maxEntriesPerUser <= 20));
    }

    // Validate Custom Badge payload (Admin / Sub-Admin only)
    function isValidBadgePayload(data) {
      return ('name' in data) && data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
        isValidOptionalString(data, 'description', 240) &&
        isValidOptionalString(data, 'color', 32) &&
        isValidOptionalString(data, 'iconName', 48) &&
        isValidOptionalString(data, 'imageUrl', 2048) &&
        (!('imageUrl' in data) || !(data.imageUrl is string) || !data.imageUrl.matches('^data:.*')) &&
        isValidOptionalString(data, 'challengeId', 160);
    }

    // Default catch-all deny rule for zero-trust baseline
    match /{document=**} {
      allow read, write: if false;
    }

    // Server-managed Admins registry (roles can ONLY be changed by a server function via Admin SDK)
    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow create, update, delete: if false;
    }

    // Read-only connection health test document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles: directory read for signed-in users, guarded create/update (no client writes to isPro or role), owner/super-admin delete
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isValidId(userId) && (isSafeUserProfileCreate(userId) || isOwnerBootstrapProfile(userId));
      allow update: if isValidId(userId) && (isSafeUserProfileUpdate(userId) || isAdminModerationUserUpdate());
      allow delete: if isSuperAdmin() || (isValidId(userId) && isOwner(userId));

      // Device FCM Push Notification Tokens — strictly private to the user
      match /fcmTokens/{tokenId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          isValidTokenId(tokenId) &&
          ('token' in request.resource.data) &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 10 &&
          request.resource.data.token.size() <= 1024 &&
          isValidOptionalString(request.resource.data, 'deviceName', 120) &&
          isValidOptionalString(request.resource.data, 'platform', 80);
      }

      // User Settings (including notification toggles at users/{uid}/settings/notifications)
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Private Saved Posts subcollection — strictly private to the user & admin
      match /savedPosts/{savedPostId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Private Creator Stats subcollection
      match /privateStats/{statDocId} {
        allow read, write: if isOwner(userId);
      }

      // Per-Chat Theme Preferences subcollection
      match /chatSettings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // Server-only push rate limit & dedupe metadata managed exclusively by Cloud Functions
      match /privatePushMeta/{docId} {
        allow read, write: if false;
      }

      // Active Device Sessions subcollection (users/{uid}/sessions/{sessionId})
      match /sessions/{sessionId} {
        allow read, delete: if isOwner(userId) || isSuperAdmin();
        allow create, update: if isOwner(userId) &&
          isValidId(sessionId) &&
          isValidOptionalString(request.resource.data, 'deviceName', 140) &&
          isValidOptionalString(request.resource.data, 'platform', 80) &&
          isValidOptionalString(request.resource.data, 'browser', 80);
      }
    }

    // Top-level Private Creator Stats collection
    match /creatorStats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Weekly Creator Challenges — readable by signed-in users, managed by Admins & Sub-Admins
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidChallengePayload(request.resource.data);
      allow delete: if isAdmin();

      // Entries inside a challenge (one entry per postId; strictly blocked after challenge endDateMs)
      match /entries/{postId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isNotBanned() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.postId == postId &&
          request.resource.data.challengeId == challengeId &&
          request.resource.data.get('moderationChecked', false) == true &&
          request.resource.data.get('likesCount', 0) == 0 &&
          exists(/databases/$(database)/documents/challenges/$(challengeId)) &&
          get(/databases/$(database)/documents/challenges/$(challengeId)).data.get('status', 'active') == 'active' &&
          (
            !('endDateMs' in get(/databases/$(database)/documents/challenges/$(challengeId)).data) ||
            request.time.toMillis() <= get(/databases/$(database)/documents/challenges/$(challengeId)).data.endDateMs
          );
        allow update: if isAdmin();
        allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      }

      // Per-user participant counters & anti-cheat metadata — server-authoritative writes only (prevents like/count spoofing)
      match /participants/{participantUid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    // Custom Badges — readable by signed-in users, created/managed by Admins & Sub-Admins
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidBadgePayload(request.resource.data);
      allow delete: if isAdmin();
    }

    // Creator Spotlight of the Week — readable by signed-in users, managed by Admins
    match /creatorSpotlights/{spotlightId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Top-level private 'Saved Posts' collection
    match /savedPosts/{savedPostId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Social feed posts (enforces post audience & mutual blocks on get & list; bounds engagement deltas; blocks client self-boosting/tip spoofing)
    match /posts/{postId} {
      allow get, list: if isSignedIn() && canReadPostDoc(resource.data);
      allow create: if isSignedIn() && isNotBanned() && isValidPostPayload(request.resource.data) && (
        isAdmin() || request.resource.data.get('moderationChecked', false) == true
      ) && (
        request.resource.data.authorId == request.auth.uid ||
        (request.resource.data.authorId == 'wavelink_support_bot' && isAdmin())
      ) && (
        isAdmin() || (
          request.resource.data.get('isBoosted', false) == false &&
          !('boostedUntil' in request.resource.data) &&
          !('boostTier' in request.resource.data) &&
          request.resource.data.get('tipsTotalTZS', 0) == 0 &&
          request.resource.data.get('tipsCount', 0) == 0
        )
      ) && (
        // Teen account posting safeguards: no location sharing, and no public posts unless parent verified & allowed
        !hasUserDoc() ||
        getUserDoc().data.get('isUnder18', false) != true ||
        (
          (!('locationTag' in request.resource.data) || request.resource.data.locationTag == null || request.resource.data.locationTag == '') &&
          (
            request.resource.data.get('audience', 'followers') != 'public' ||
            (
              getUserDoc().data.get('parentalStatus', 'unverified_teen') == 'linked' &&
              getUserDoc().data.get('parentalSettings', {}).get('profileVisibility', 'private') == 'public' &&
              getUserDoc().data.get('parentalSettings', {}).get('isPaused', false) != true
            )
          )
        )
      );
      allow update: if isSignedIn() && isValidPostPayload(request.resource.data) && (
        isAdmin() ||
        (
          isSupportHelper() &&
          request.resource.data.get('isHidden', false) == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isHidden',
            'moderationStatus',
            'moderationReason',
            'updatedAt'
          ])
        ) ||
        (
          resource.data.authorId == request.auth.uid &&
          areImmutableFieldsUnchanged(['authorId', 'createdAt', 'challengeId', 'isBoosted', 'boostedUntil', 'boostTier', 'tipsTotalTZS', 'tipsCount'])
        ) ||
        (
          !isBlockedMutual(resource.data.get('authorId', '')) &&
          math.abs(request.resource.data.get('likesCount', 0) - resource.data.get('likesCount', 0)) <= 1 &&
          math.abs(request.resource.data.get('commentsCount', 0) - resource.data.get('commentsCount', 0)) <= 1 &&
          math.abs(request.resource.data.get('savesCount', 0) - resource.data.get('savesCount', 0)) <= 1 &&
          math.abs(request.resource.data.get('sharesCount', 0) - resource.data.get('sharesCount', 0)) <= 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likes',
            'likesCount',
            'reactions',
            'reactionCounts',
            'commentsCount',
            'savesCount',
            'sharesCount',
            'sharedBy',
            'updatedAt'
          ])
        ) ||
        (
          !isBlockedMutual(resource.data.get('authorId', '')) &&
          !(request.auth.uid in resource.data.get('reportedBy', [])) &&
          (request.auth.uid in request.resource.data.get('reportedBy', [])) &&
          request.resource.data.get('reportCount', 0) == resource.data.get('reportCount', 0) + 1 &&
          request.resource.data.get('isHidden', false) == (resource.data.get('isHidden', false) || request.resource.data.get('reportCount', 0) >= 3) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reportCount',
            'reportedBy',
            'isHidden',
            'moderationStatus',
            'updatedAt'
          ])
        )
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isNotBanned() &&
          isValidCommentPayload(request.resource.data) &&
          (isAdmin() || request.resource.data.get('moderationChecked', false) == true) &&
          request.resource.data.authorId == request.auth.uid &&
          (!exists(/databases/$(database)/documents/posts/$(postId)) ||
           !isBlockedMutual(get(/databases/$(database)/documents/posts/$(postId)).data.get('authorId', '')));
        allow update: if isSignedIn() &&
          isValidCommentPayload(request.resource.data) &&
          areImmutableFieldsUnchanged(['authorId', 'postId', 'createdAt']) &&
          (
            resource.data.authorId == request.auth.uid ||
            isAdmin() ||
            (
              isSupportHelper() &&
              request.resource.data.get('isHidden', false) == true &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHidden', 'moderationStatus', 'updatedAt'])
            ) ||
            (
              !isBlockedMutual(resource.data.get('authorId', '')) &&
              areImmutableFieldsUnchanged(['content']) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reactionCounts', 'updatedAt'])
            ) ||
            (
              !isBlockedMutual(resource.data.get('authorId', '')) &&
              areImmutableFieldsUnchanged(['content']) &&
              !(request.auth.uid in resource.data.get('reportedBy', [])) &&
              (request.auth.uid in request.resource.data.get('reportedBy', [])) &&
              request.resource.data.get('reportCount', 0) == resource.data.get('reportCount', 0) + 1 &&
              request.resource.data.get('isHidden', false) == (resource.data.get('isHidden', false) || request.resource.data.get('reportCount', 0) >= 3) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'reportedBy', 'isHidden', 'moderationStatus', 'updatedAt'])
            )
          );
        allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          isAdmin() ||
          (exists(/databases/$(database)/documents/posts/$(postId)) &&
           get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid)
        );
      }
    }

    // Validate Spark payload: never allow base64 video in Firestore, enforce caption size, and enforce 60s Free / 90s Pro duration limits
    function isValidSparkPayload() {
      let data = request.resource.data;
      return ('authorId' in data) && data.authorId is string && data.authorId.size() <= 128 &&
        isValidOptionalString(data, 'caption', 600) &&
        isValidOptionalString(data, 'legendaryTag', 80) &&
        (!('mediaSafety' in data) || data.mediaSafety == null || data.mediaSafety in ['safe', 'borderline']) &&
        (!('mediaUrl' in data) || !(data.mediaUrl is string) || !data.mediaUrl.matches('^data:video/.*')) &&
        (!('videoDurationSeconds' in data) || (
          data.videoDurationSeconds is number &&
          data.videoDurationSeconds >= 0 &&
          data.videoDurationSeconds <= 90.5
        )) &&
        (!('videoFileSize' in data) || (data.videoFileSize is number && data.videoFileSize <= 80 * 1024 * 1024));
    }

    // Sparks: 24-hour ephemeral moments
    match /sparks/{sparkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned() && isValidSparkPayload() && (
        isAdmin() || request.resource.data.get('moderationChecked', false) == true
      ) && (
        request.resource.data.authorId == request.auth.uid ||
        (request.resource.data.authorId == 'wavelink_support_bot' && isAdmin())
      );
      allow update: if isSignedIn() && isValidSparkPayload() && (
        (resource.data.authorId == request.auth.uid && areImmutableFieldsUnchanged(['authorId', 'createdAt'])) ||
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likes',
            'likesCount',
            'likedUsers',
            'viewers',
            'viewersCount',
            'viewerUsers'
          ]) &&
          request.resource.data.get('viewersCount', 0) >= resource.data.get('viewersCount', 0) &&
          request.resource.data.get('likesCount', 0) >= resource.data.get('likesCount', 0) - 1 &&
          request.resource.data.get('likesCount', 0) <= resource.data.get('likesCount', 0) + 1
        )
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          isAdmin() ||
          (exists(/databases/$(database)/documents/sparks/$(sparkId)) &&
           get(/databases/$(database)/documents/sparks/$(sparkId)).data.authorId == request.auth.uid)
        );
      }
    }

    // Global Announcements & Community Notice Board Events
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isNotBanned() && (
        (request.resource.data.authorId == request.auth.uid &&
         request.resource.data.get('isPinned', false) == false &&
         request.resource.data.get('isOfficialPartner', false) == false) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.authorId == request.auth.uid &&
         areImmutableFieldsUnchanged(['authorId', 'createdAt', 'isPinned', 'isOfficialPartner'])) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpUserIds', 'rsvpCount'])
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          isAdmin() ||
          (exists(/databases/$(database)/documents/announcements/$(announcementId)) &&
           get(/databases/$(database)/documents/announcements/$(announcementId)).data.authorId == request.auth.uid)
        );
      }
    }

    // Support Tickets & Complaints (readable/writable by ticket owner, Admin, Moderator, or Support Helper)
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isStaff());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow delete: if isAdmin();
    }

    // WaveLink Support Bot Config (readable by signed-in users, editable only by Admins)
    match /supportBotConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // WaveLink Support Bot Conversation Logs & Bad Reply Reports
    match /supportBotLogs/{logId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isStaff() ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBadReply', 'reportReason', 'escalatedToTicketId']))
      );
      allow delete: if isAdmin();
    }

    // Scheduled Bot Drafts — strictly Admin managed
    match /scheduledBotDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // Content & User Reports (Posts, Comments, Reels, Messages, Accounts, Bad Bot Replies)
    match /contentReports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isStaff());
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.get('status', 'open') in ['open', 'auto_hidden'] &&
        isValidOptionalString(request.resource.data, 'reason', 500) &&
        isValidOptionalString(request.resource.data, 'details', 2000);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Appeals for Hidden Content & Account Suspensions
    match /appeals/{appealId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isValidOptionalString(request.resource.data, 'reason', 2000);
      allow update, delete: if isAdmin();
    }

    // Global Service Status Banner & System Config (readable by all, writable ONLY by Owner)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Server-managed Staff Roles Registry (roles can ONLY be changed by a server function via Admin SDK)
    match /staff_roles/{staffUid} {
      allow read: if isOwner(staffUid) || isStaff();
      allow create, update, delete: if false;
    }

    // Admin Security Audit Log (Bans, Role Changes, Verifications, Deletions, Support Actions)
    match /adminAuditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if isSuperAdmin();
    }

    // Helper: verify group suggestedTheme updates:
    // - Group admins/owner can set or clear suggestedTheme
    // - Non-admin group members can only accept/decline an existing suggestion without altering its theme or suggester
    function isValidGroupSuggestedThemeUpdate(groupId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['suggestedTheme']) ||
        isGroupAdmin(groupId) || (
          isGroupMember(groupId) &&
          resource.data.suggestedTheme != null &&
          request.resource.data.suggestedTheme != null &&
          request.resource.data.suggestedTheme.themeId == resource.data.suggestedTheme.themeId &&
          request.resource.data.suggestedTheme.suggestedBy == resource.data.suggestedTheme.suggestedBy &&
          request.resource.data.suggestedTheme.suggestedAt == resource.data.suggestedTheme.suggestedAt
        );
    }

    function isGroupSelfLeave() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldMembers = resource.data.get('memberIds', []);
      let newMembers = request.resource.data.get('memberIds', []);
      return request.auth.uid in oldMembers &&
        !(request.auth.uid in newMembers) &&
        newMembers.size() == oldMembers.size() - 1 && (
          changed.hasOnly(['memberIds', 'adminIds', 'updatedAt']) ||
          (
            resource.data.creatorId == request.auth.uid &&
            changed.hasOnly(['memberIds', 'adminIds', 'creatorId', 'updatedAt']) &&
            (newMembers.size() == 0 || request.resource.data.creatorId in newMembers)
          )
        );
    }

    // User-created groups & group messages (member-scoped access, Owner/Admin/Member RBAC, disappearing timer)
    match /groups/{groupId} {
      allow get, list: if isSignedIn() && (
        request.auth.uid in resource.data.get('memberIds', []) ||
        resource.data.get('creatorId', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isNotBanned() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.auth.uid in request.resource.data.get('memberIds', []) &&
        isValidOptionalString(request.resource.data, 'name', 80) &&
        isValidOptionalString(request.resource.data, 'description', 400) &&
        (!('disappearingHours' in request.resource.data) || request.resource.data.disappearingHours in [0, 24, 168, 720]);
      allow update: if isGroupMember(groupId) &&
        isValidGroupSuggestedThemeUpdate(groupId) &&
        isValidOptionalString(request.resource.data, 'name', 80) &&
        isValidOptionalString(request.resource.data, 'description', 400) &&
        (!('disappearingHours' in request.resource.data) || request.resource.data.disappearingHours in [0, 24, 168, 720]) &&
        areImmutableFieldsUnchanged(['creatorEmail', 'createdAt']) && (
          isAdmin() ||
          isGroupSelfLeave() ||
          (
            isGroupAdmin(groupId) &&
            areImmutableFieldsUnchanged(['creatorId']) &&
            resource.data.get('creatorId', '') in request.resource.data.get('memberIds', [])
          ) ||
          (
            areImmutableFieldsUnchanged(['creatorId', 'memberIds', 'adminIds', 'name', 'description', 'logoUrl', 'disappearingHours'])
          )
        );
      allow delete: if isSignedIn() && (resource.data.creatorId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && isNotBanned() &&
          request.resource.data.senderId == request.auth.uid &&
          (
            isAdmin() ||
            request.resource.data.get('isSystem', false) == true ||
            request.resource.data.get('moderationChecked', false) == true
          ) &&
          isValidOptionalString(request.resource.data, 'text', 4000) &&
          isValidOptionalString(request.resource.data, 'expiresAt', 64);
        allow update: if isGroupMember(groupId) && (
          resource.data.senderId == request.auth.uid ||
          isGroupAdmin(groupId) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'lastSeenAt', 'reactions'])
        );
        allow delete: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          isGroupAdmin(groupId)
        );
      }
    }

    // Server-side DM privacy & mutual-block validator:
    // Rejects starting or sending messages in a conversation if:
    //  1. Either user has blocked the other (isBlockedMutual(otherUid)).
    //  2. The recipient has privacySettings.allowDirectMessages == 'followers' ("Only people I follow / friends")
    //     and does NOT follow or have the sender in their contactIds/closeFriendIds (unless already accepted).
    //  3. The recipient has privacySettings.allowDirectMessages == 'none' (unless already accepted or sender is admin).
    function canMessageRecipient(otherUid, channelId) {
      return isAdmin() ||
        otherUid == '' ||
        otherUid == request.auth.uid ||
        otherUid == 'wavelink_support_bot' ||
        (
          !isBlockedMutual(otherUid) && (
            !exists(/databases/$(database)/documents/users/$(otherUid)) ||
            (
              get(/databases/$(database)/documents/users/$(otherUid)).data.get('privacySettings', {}).get('allowDirectMessages', 'everyone') == 'everyone'
            ) ||
            (
              get(/databases/$(database)/documents/users/$(otherUid)).data.get('privacySettings', {}).get('allowDirectMessages', 'everyone') == 'followers' && (
                request.auth.uid in get(/databases/$(database)/documents/users/$(otherUid)).data.get('followingIds', []) ||
                request.auth.uid in get(/databases/$(database)/documents/users/$(otherUid)).data.get('contactIds', []) ||
                request.auth.uid in get(/databases/$(database)/documents/users/$(otherUid)).data.get('closeFriendIds', []) ||
                exists(/databases/$(database)/documents/follows/$(otherUid + '_' + request.auth.uid)) ||
                (
                  exists(/databases/$(database)/documents/channels/$(channelId)) && (
                    otherUid in get(/databases/$(database)/documents/channels/$(channelId)).data.get('acceptedBy', []) ||
                    get(/databases/$(database)/documents/channels/$(channelId)).data.get('lastMessageSenderId', '') == otherUid
                  )
                )
              )
            ) ||
            (
              exists(/databases/$(database)/documents/channels/$(channelId)) &&
              otherUid in get(/databases/$(database)/documents/channels/$(channelId)).data.get('acceptedBy', [])
            )
          )
        );
    }

    function canWriteDmChannelParticipants(participants, channelId) {
      return participants is list &&
        participants.size() >= 1 &&
        participants.size() <= 2 &&
        request.auth.uid in participants && (
          participants.size() == 1 ||
          (participants[0] == request.auth.uid ? canMessageRecipient(participants[1], channelId) : canMessageRecipient(participants[0], channelId))
        );
    }

    // Real-Time Direct Messages & Official Updates Channel (Strictly participant-scoped, immutable participant list)
    match /channels/{channelId} {
      allow get: if isDmMember(channelId);
      allow list: if isSignedIn() && (request.auth.uid in resource.data.get('participants', []) || isAdmin());
      allow create: if channelId == 'official_updates' ? isAdmin() : (
        isSignedIn() && isNotBanned() &&
        canWriteDmChannelParticipants(request.resource.data.get('participants', []), channelId) &&
        (!('senderMessageCount' in request.resource.data) || request.resource.data.senderMessageCount <= 2 || request.resource.data.get('requestStatus', 'accepted') == 'accepted') &&
        (!('disappearingHours' in request.resource.data) || request.resource.data.disappearingHours in [0, 24, 168, 720])
      );
      allow update: if channelId == 'official_updates' ? isAdmin() : (
        isDmMember(channelId) &&
        areImmutableFieldsUnchanged(['participants', 'createdAt']) &&
        (
          !('participants' in request.resource.data) ||
          canWriteDmChannelParticipants(request.resource.data.get('participants', []), channelId)
        ) &&
        (
          request.resource.data.get('requestStatus', 'accepted') != 'pending' ||
          request.resource.data.get('initiatedBy', '') != request.auth.uid ||
          !('senderMessageCount' in request.resource.data) ||
          request.resource.data.senderMessageCount <= 2
        ) &&
        (!('disappearingHours' in request.resource.data) || request.resource.data.disappearingHours in [0, 24, 168, 720])
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isDmMember(channelId) || (
          isSignedIn() &&
          resource != null && (
            resource.data.get('senderId', '') == request.auth.uid ||
            resource.data.get('receiverId', '') == request.auth.uid ||
            request.auth.uid in resource.data.get('participants', [])
          )
        );
        allow create: if isNotBanned() && (
          isDmMember(channelId) ||
          (isSignedIn() && request.auth.uid in request.resource.data.get('participants', []))
        ) && (
          (request.resource.data.senderId == request.auth.uid && (channelId != 'official_updates' || isAdmin())) ||
          (request.resource.data.senderId == 'wavelink_support_bot' && channelId.matches('.*wavelink_support_bot.*'))
        ) && (
          isAdmin() ||
          request.resource.data.get('senderId', '') == 'wavelink_support_bot' ||
          request.resource.data.get('isSystem', false) == true ||
          request.resource.data.get('moderationChecked', false) == true
        ) &&
        (!('receiverId' in request.resource.data) || canMessageRecipient(request.resource.data.get('receiverId', ''), channelId)) &&
        isValidOptionalString(request.resource.data, 'text', 4000) &&
        isValidOptionalString(request.resource.data, 'expiresAt', 64);
        allow update: if isDmMember(channelId) && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'lastSeenAt', 'reportedBadReply', 'reactions', 'reportedBy', 'reportCount', 'isHidden'])
        );
        allow delete: if isDmMember(channelId) && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // Conversations collection alias (strictly participant-scoped)
    match /conversations/{conversationId} {
      allow read: if isDmMember(conversationId) || (
        isSignedIn() && resource != null && request.auth.uid in resource.data.get('participants', [])
      );
      allow create: if isSignedIn() && isNotBanned() &&
        canWriteDmChannelParticipants(request.resource.data.get('participants', []), conversationId) &&
        (!('disappearingHours' in request.resource.data) || request.resource.data.disappearingHours in [0, 24, 168, 720]);
      allow update: if (isDmMember(conversationId) || (
        isSignedIn() && resource != null && request.auth.uid in resource.data.get('participants', [])
      )) && areImmutableFieldsUnchanged(['participants', 'createdAt']) &&
        (!('disappearingHours' in request.resource.data) || request.resource.data.disappearingHours in [0, 24, 168, 720]);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isDmMember(conversationId) || (
          isSignedIn() &&
          resource != null && (
            resource.data.get('senderId', '') == request.auth.uid ||
            resource.data.get('receiverId', '') == request.auth.uid ||
            request.auth.uid in resource.data.get('participants', [])
          )
        );
        allow create: if isNotBanned() && (
          isDmMember(conversationId) ||
          (isSignedIn() && request.auth.uid in request.resource.data.get('participants', []))
        ) &&
        request.resource.data.senderId == request.auth.uid &&
        (!('receiverId' in request.resource.data) || canMessageRecipient(request.resource.data.get('receiverId', ''), conversationId)) &&
        isValidOptionalString(request.resource.data, 'text', 4000) &&
        isValidOptionalString(request.resource.data, 'expiresAt', 64);
        allow update: if isDmMember(conversationId) && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'lastSeenAt', 'reactions'])
        );
        allow delete: if isDmMember(conversationId) && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // Global App Settings (video/voice call locks)
    match /appSettings/{settingsId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Subscriptions and mobile payment transactions (user can create pending tx; server/admin completes or modifies)
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.get('status', 'pending') in ['pending', 'processing'];
      allow update, delete: if isAdmin();
    }

    // Payment Gateway Developer Settings (Client IDs, Secrets, Webhook)
    match /paymentConfig/{configId} {
      allow read, write: if isSuperAdmin();
    }

    // In-App Notifications (actorId must match caller or Admin; blocked users cannot send notifications; recipient can only mark read)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        (request.resource.data.actorId == request.auth.uid || isAdmin()) &&
        ('recipientId' in request.resource.data) &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientId.size() <= 128 &&
        !isBlockedMutual(request.resource.data.recipientId) &&
        (isAdmin() || request.resource.data.get('type', '') != 'system' || request.resource.data.recipientId == 'keylan_admin') &&
        isValidOptionalString(request.resource.data, 'title', 160) &&
        isValidOptionalString(request.resource.data, 'body', 600);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.recipientId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']))
      );
      allow delete: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // User Follows (prevents self-follow, duplicate follow inflation, and following when mutually blocked)
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.followerId == request.auth.uid &&
        ('followingId' in request.resource.data) &&
        request.resource.data.followingId is string &&
        request.resource.data.followingId != request.auth.uid &&
        !isBlockedMutual(request.resource.data.followingId) &&
        (followId == request.auth.uid + '_' + request.resource.data.followingId ||
         followId == 'follow_' + request.auth.uid + '_' + request.resource.data.followingId);
      allow delete: if isSignedIn() && (resource.data.followerId == request.auth.uid || isAdmin());
    }

    // Manual Mobile Money Transaction Verifications for WaveLink Pro
    match /pending_verifications/{verificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.get('status', 'pending') in ['pending', 'pending_review'];
      allow update, delete: if isAdmin();
    }

    // Direct Manual Payment Requests for WaveLink Pro & Harvest Pass
    match /payment_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.get('status', 'pending') in ['pending', 'pending_review'];
      allow update, delete: if isAdmin();
    }

    // System Domains for OAuth Whitelisting tracking — signed-in read, Admin write only
    match /system_domains/{domainId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Official Coupon & Promo Codes — no public/bulk enumeration; get by exact code ID only
    match /coupons/{codeId} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    match /promo_codes/{codeId} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    // AI-Collected Platform Upgrades & Feature Feedback
    match /upgrade_feedback/{feedbackId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.submittedByUserId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.submittedByUserId == request.auth.uid &&
        isValidOptionalString(request.resource.data, 'rawSuggestion', 2000);
      allow update, delete: if isAdmin();
    }

    // Live Video & Voice Calls (Strictly participant-only, anti-spoofing, bounded SDP size)
    function isCallParticipantData(d) {
      return d != null && (
        d.get('callerId', '') == request.auth.uid ||
        d.get('calleeId', '') == request.auth.uid ||
        d.get('receiverId', '') == request.auth.uid ||
        d.get('caller', '') == request.auth.uid ||
        d.get('receiver', '') == request.auth.uid
      );
    }

    function isCallParticipant(callId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/calls/$(callId)) &&
        isCallParticipantData(get(/databases/$(database)/documents/calls/$(callId)).data);
    }

    function isValidCallPayload(data) {
      return (!('type' in data) || data.type in ['voice', 'video', 'audio']) &&
        (!('callType' in data) || data.callType in ['voice', 'video', 'audio']) &&
        (!('status' in data) || data.status in ['ringing', 'calling', 'offered', 'accepted', 'answered', 'connected', 'active', 'ended', 'declined', 'rejected', 'missed', 'no_answer', 'busy', 'cancelled']) &&
        (!('offer' in data) || data.offer == null || (data.offer is map && (!('sdp' in data.offer) || (data.offer.sdp is string && data.offer.sdp.size() <= 40000)))) &&
        (!('answer' in data) || data.answer == null || (data.answer is map && (!('sdp' in data.answer) || (data.answer.sdp is string && data.answer.sdp.size() <= 40000))));
    }

    match /calls/{callId} {
      allow get: if isSignedIn() && isValidId(callId) && (
        resource == null || isCallParticipantData(resource.data)
      );
      allow list: if isSignedIn() && isCallParticipantData(resource.data);
      allow create: if isSignedIn() && isNotBanned() &&
        isValidId(callId) &&
        isValidCallPayload(request.resource.data) &&
        (request.resource.data.get('callerId', '') == request.auth.uid ||
         request.resource.data.get('caller', '') == request.auth.uid) &&
        ((isAdmin() && callId.matches('^sys_health_.*')) ||
         ((request.resource.data.get('calleeId', '') is string &&
           request.resource.data.get('calleeId', '').size() > 0 &&
           request.resource.data.get('calleeId', '') != request.auth.uid &&
           !isBlockedMutual(request.resource.data.get('calleeId', ''))) ||
          (request.resource.data.get('receiverId', '') is string &&
           request.resource.data.get('receiverId', '').size() > 0 &&
           request.resource.data.get('receiverId', '') != request.auth.uid &&
           !isBlockedMutual(request.resource.data.get('receiverId', ''))) ||
          (request.resource.data.get('receiver', '') is string &&
           request.resource.data.get('receiver', '').size() > 0 &&
           request.resource.data.get('receiver', '') != request.auth.uid &&
           !isBlockedMutual(request.resource.data.get('receiver', ''))))) &&
        !request.resource.data.keys().hasAny(['callerPhotoURL', 'receiverPhotoURL', 'calleePhotoURL']) &&
        (
          // Teen accounts cannot initiate calls unless parent verified & explicitly enabled allowCalls
          !hasUserDoc() ||
          getUserDoc().data.get('isUnder18', false) != true ||
          (
            getUserDoc().data.get('parentalStatus', 'unverified_teen') == 'linked' &&
            getUserDoc().data.get('parentalSettings', {}).get('allowCalls', false) == true &&
            getUserDoc().data.get('parentalSettings', {}).get('isPaused', false) != true
          )
        );
      allow update: if isSignedIn() &&
        isValidId(callId) &&
        isValidCallPayload(request.resource.data) &&
        resource != null &&
        isCallParticipantData(resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['caller', 'callerId', 'calleeId', 'receiver', 'receiverId', 'callerPhotoURL', 'receiverPhotoURL', 'calleePhotoURL']);
      allow delete: if isSignedIn() &&
        isValidId(callId) &&
        resource != null &&
        isCallParticipantData(resource.data);

      match /callerCandidates/{candidateId} {
        allow get, list: if isCallParticipant(callId);
        allow create, update: if isValidId(candidateId) &&
          isCallParticipant(callId) &&
          (!('candidate' in request.resource.data) ||
           (request.resource.data.candidate is string && request.resource.data.candidate.size() <= 2048));
        allow delete: if isValidId(candidateId) && isCallParticipant(callId);
      }

      match /calleeCandidates/{candidateId} {
        allow get, list: if isCallParticipant(callId);
        allow create, update: if isValidId(candidateId) &&
          isCallParticipant(callId) &&
          (!('candidate' in request.resource.data) ||
           (request.resource.data.candidate is string && request.resource.data.candidate.size() <= 2048));
        allow delete: if isValidId(candidateId) && isCallParticipant(callId);
      }
    }

    // ===============================================================
    // ROLES (/roles/{uid}) — Only main "admin" (isSuperAdmin) can write
    // ===============================================================
    function isValidRoleDocPayload(data, targetUid) {
      return data.keys().hasAll(['uid', 'role', 'updatedAt']) &&
        data.uid == targetUid &&
        data.role in ['admin', 'subadmin'] &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        isValidOptionalString(data, 'username', 60) &&
        isValidOptionalString(data, 'displayName', 100) &&
        isValidOptionalString(data, 'email', 160) &&
        isValidOptionalString(data, 'photoURL', 2048) &&
        isValidOptionalString(data, 'assignedBy', 128);
    }

    match /roles/{roleUid} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(roleUid) &&
        isSuperAdmin() &&
        isValidRoleDocPayload(request.resource.data, roleUid);
      allow delete: if isValidId(roleUid) && isSuperAdmin();
    }

    // ===============================================================
    // ADMIN UPDATES (/adminUpdates/{updateId})
    // ===============================================================
    function isValidAdminUpdatePayload(data) {
      return data.keys().hasAll(['title', 'message', 'type', 'authorUid', 'authorName', 'role', 'createdAt', 'deleted']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 3000 &&
        isValidOptionalString(data, 'messageSw', 3000) &&
        data.type in ['new_feature', 'improvement', 'bug_fix', 'maintenance', 'announcement'] &&
        isValidOptionalString(data, 'imageUrl', 2048) &&
        (!('imageUrl' in data) || !(data.imageUrl is string) || !data.imageUrl.matches('^data:.*')) &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        data.role in ['admin', 'subadmin'] &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64 &&
        isValidOptionalString(data, 'updatedAt', 64) &&
        (!('pinned' in data) || data.pinned == null || data.pinned is bool) &&
        (!('alsoSendPush' in data) || data.alsoSendPush == null || data.alsoSendPush is bool) &&
        data.deleted is bool;
    }

    match /adminUpdates/{updateId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(updateId) &&
        isNotBanned() &&
        isAdmin() &&
        isValidAdminUpdatePayload(request.resource.data) &&
        request.resource.data.authorUid == request.auth.uid &&
        (isSuperAdmin() ? request.resource.data.role == 'admin' : request.resource.data.role == 'subadmin');
      allow update: if isValidId(updateId) &&
        isNotBanned() &&
        isValidAdminUpdatePayload(request.resource.data) &&
        areImmutableFieldsUnchanged(['authorUid', 'createdAt']) &&
        (
          isSuperAdmin() ||
          (isSubAdmin() &&
           resource.data.authorUid == request.auth.uid &&
           request.resource.data.role == 'subadmin')
        );
      allow delete: if isValidId(updateId) &&
        isNotBanned() &&
        (
          isSuperAdmin() ||
          (isSubAdmin() && resource.data.authorUid == request.auth.uid)
        );
    }

    // ===============================================================
    // PARENTAL CONTROLS — Strictly private to linked parent & teen.
    // All writes are server-authoritative (Admin SDK only) so teens
    // can NEVER tamper with verification codes, limits, or pause state.
    // ===============================================================
    function isParentOrTeenParticipant(data) {
      return isSignedIn() && (
        data.get('teenUid', '') == request.auth.uid ||
        data.get('parentUid', '') == request.auth.uid ||
        (
          isEmailVerified() &&
          request.auth.token.email is string &&
          data.get('parentEmailLower', '') == request.auth.token.email.lower()
        )
      );
    }

    match /parentalLinks/{linkId} {
      allow get: if isValidId(linkId) && isParentOrTeenParticipant(resource.data);
      allow list: if isParentOrTeenParticipant(resource.data);
      allow create, update, delete: if false;
    }

    match /parentalAlerts/{alertId} {
      allow get: if isValidId(alertId) && isParentOrTeenParticipant(resource.data);
      allow list: if isParentOrTeenParticipant(resource.data);
      allow create, update, delete: if false;
    }

    match /parentalFollowRequests/{reqId} {
      allow get: if isValidId(reqId) && (
        isParentOrTeenParticipant(resource.data) ||
        (isSignedIn() && resource.data.get('requesterUid', '') == request.auth.uid)
      );
      allow list: if isParentOrTeenParticipant(resource.data) ||
        (isSignedIn() && resource.data.get('requesterUid', '') == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /parentalDeletionRequests/{reqId} {
      allow get: if isValidId(reqId) && (isSuperAdmin() || isParentOrTeenParticipant(resource.data));
      allow list: if isSuperAdmin() || isParentOrTeenParticipant(resource.data);
      allow create, update, delete: if false;
    }
  }
}

